[2.614894390106201, "o", "\u001b[0;37m    \"Arn\": \"arn:aws:sts::736676210666:assumed-role/demo-attacker-source-94222/demo-talk\"\u001b[0m\n"]
[2.614896059036255, "o", "\u001b[0;37m}\u001b[0m\n"]
[2.6148977279663086, "o", "\n"]
[3.415759563446045, "o", "\u001b[1;36m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\n"]
[3.4158387184143066, "o", "\u001b[1;36m  0:15  Enumerating IAM. Parsing trust policies.\u001b[0m\n"]
[3.415841579437256, "o", "\u001b[1;36m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\n\n"]
[4.016484022140503, "o", "\u001b[1;36m\u00bb List roles in this account. There may be something interesting nearby.\u001b[0m\n"]
[4.61662220954895, "o", "\u001b[1;33m$ aws iam list-roles --query 'Roles[?contains(RoleName, `demo-`)].RoleName' --output table\u001b[0m\n"]
[6.133510589599609, "o", "\u001b[0;37m--------------------------------\u001b[0m\n"]
[6.133530378341675, "o", "\u001b[0;37m|           ListRoles          |\u001b[0m\n"]
[6.133532524108887, "o", "\u001b[0;37m+------------------------------+\u001b[0m\n"]
[6.133533477783203, "o", "\u001b[0;37m|  demo-attacker-source-94222  |\u001b[0m\n"]
[6.133534669876099, "o", "\u001b[0;37m+------------------------------+\u001b[0m\n"]
[6.133536100387573, "o", "\n"]
[6.9344260692596436, "o", "\u001b[1;36m\u00bb Now my own role's policy \u2014 what AM I allowed to do?\u001b[0m\n"]
[7.535137176513672, "o", "\u001b[1;33m$ aws iam get-role-policy --role-name demo-attacker-source-94222 --policy-name AttackerPolicy --query 'PolicyDocument.Statement' --output json\u001b[0m\n"]
[8.80548644065857, "o", "\u001b[0;37m[\u001b[0m\n"]
[8.805516242980957, "o", "\u001b[0;37m    {\u001b[0m\n"]
[8.805520296096802, "o", "\u001b[0;37m        \"Sid\": \"IAMRecon\",\u001b[0m\n"]
[8.805522441864014, "o", "\u001b[0;37m        \"Effect\": \"Allow\",\u001b[0m\n"]
[8.805524826049805, "o", "\u001b[0;37m        \"Action\": [\u001b[0m\n"]
