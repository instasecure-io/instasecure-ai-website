---
import Button from '@/components/ui/Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  image?: { src: string; alt: string; width?: number; height?: number; poster?: string };
}
const { eyebrow, title, description, primaryCta, secondaryCta, image } = Astro.props;
const isVideo = !!image && /\.(mp4|webm)(\?|$)/i.test(image.src);
---
<section class="relative overflow-hidden bg-gradient-to-br from-white via-[var(--color-brand)]/[0.04] to-[var(--color-accent)]/[0.05]">
  <div class="absolute top-0 right-0 w-96 h-96 bg-[var(--color-accent)]/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-[var(--color-brand)]/10 rounded-full blur-3xl -z-10"></div>
  <div class="mx-auto max-w-7xl px-6 pt-20 pb-24 grid md:grid-cols-2 gap-12 items-center relative">
    <div>
      {eyebrow && <div class="text-sm uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-4">{eyebrow}</div>}
      <h1 class="text-5xl md:text-7xl font-bold leading-[1.05] tracking-tight text-[var(--color-text)]">{title}</h1>
      <p class="text-lg md:text-xl text-slate-800 mt-6 max-w-xl leading-relaxed">{description}</p>
      <div class="flex flex-wrap gap-3 mt-8">
        {primaryCta && <Button href={primaryCta.href} variant="accent" size="lg">{primaryCta.label}</Button>}
        {secondaryCta && <Button href={secondaryCta.href} variant="secondary" size="lg">{secondaryCta.label}</Button>}
      </div>
    </div>
    {image && (
      <div
        class="relative w-full"
        style={image.width && image.height ? `aspect-ratio: ${image.width} / ${image.height};` : undefined}
      >
        {isVideo ? (
          <video
            src={image.src}
            poster={image.poster}
            width={image.width}
            height={image.height}
            class="absolute inset-0 w-full h-full rounded-2xl shadow-lg block object-cover"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            aria-label={image.alt}
          ></video>
        ) : (
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            class="absolute inset-0 w-full h-full rounded-2xl shadow-lg object-cover"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>
    )}
  </div>
</section>
