---
// src/components/sections/GuardrailsChallenge.astro
// Options are drawn ONLY from the public representative pool — the full 122-control catalog
// is private IP and is never imported here or shipped in the payload.
import { SCENARIOS } from '@/data/guardrails/scenarios';
import { THREATS } from '@/data/guardrails/threats';
import { REPRESENTATIVE_CONTROLS } from '@/data/guardrails/representative-controls';
import { CATALOG } from '@/data/guardrails/catalog-summary';

const nameById = new Map(REPRESENTATIVE_CONTROLS.map(c => [c.id, c.name]));
const pool = REPRESENTATIVE_CONTROLS.map(c => c.id);
// Deterministic distractor pick from the representative pool (no build-time randomness).
function distractors(correct: string, i: number): string[] {
  const cands = pool.filter(id => id !== correct);
  const out: string[] = [];
  for (let k = 0; out.length < 3 && k < cands.length * 2; k++) {
    const id = cands[(i * 3 + k * 7) % cands.length];
    if (!out.includes(id)) out.push(id);
  }
  return out;
}
const scenarios = SCENARIOS.map((s, i) => ({
  id: s.id, threat: s.threat, title: s.title, scenario: s.scenario, explain: s.explain, correct: s.correct,
  options: [s.correct, ...distractors(s.correct, i)].map(id => ({ id, name: nameById.get(id) ?? id })),
}));
const payload = { rounds: 8, timerOn: true, threats: THREATS, scenarios, catalogTotal: CATALOG.total };
---
<section class="gc-arena relative">
  <div class="mx-auto max-w-[1080px] px-5 py-8">
    <div data-gc-root class="min-h-[420px]"></div>
  </div>
  <footer class="mx-auto max-w-[1080px] px-5 grid gap-1.5 justify-items-center text-center pt-4 pb-2">
    <span class="text-[12.5px] text-slate-400">A representative sample of InstaSecure's {payload.catalogTotal} guardrails — see the full catalog in action. <a href="/contact" class="text-[var(--color-brand)] font-semibold">Talk to us</a>.</span>
    <span class="text-[12.5px] text-slate-400">Wondering where your org stands? <a href="/learn/guardrails-assessment" class="text-[var(--color-brand)] font-semibold">Assess your coverage</a>.</span>
    <span class="text-[12.5px] text-slate-400">Every one of these ships enforced, org-wide, in minutes. <a href="/contact" class="text-[var(--color-brand)] font-semibold">Book a demo</a>.</span>
  </footer>
</section>

<script type="application/json" id="gc-data" is:inline set:html={JSON.stringify(payload).replace(/</g, '\\u003c')}></script>

<script>
  import { initGuardrailsChallenge } from '@/scripts/guardrails-challenge/controller';
  function boot() {
    const root = document.querySelector<HTMLElement>('[data-gc-root]');
    const dataEl = document.getElementById('gc-data');
    if (!root || !dataEl || root.dataset.gcBound === '1') return;
    root.dataset.gcBound = '1';
    const data = JSON.parse(dataEl.textContent || '{}');
    const teardown = initGuardrailsChallenge(root, data);
    document.addEventListener('astro:before-swap', () => teardown(), { once: true });
  }
  document.addEventListener('astro:page-load', boot);
  if (document.readyState !== 'loading') boot();
  else document.addEventListener('DOMContentLoaded', boot);
</script>

<style>
  .gc-arena {
    background-color: #f8f9fe;
    background-image: radial-gradient(#dfe3f0 1px, transparent 1px);
    background-size: 24px 24px;
    border-top: 1px solid var(--color-border, rgba(0,0,0,0.05));
    border-bottom: 1px solid var(--color-border, rgba(0,0,0,0.05));
  }
</style>
