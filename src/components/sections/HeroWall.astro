---
// "The Wall" — static hero visual showing a closed perimeter around
// the Cloud Control Plane with three attacks bouncing off (stolen
// cred denied, rogue agent blocked, privilege drift no blast radius).
// Pure static SVG, no JS.
---
<figure class="hero-wall" aria-hidden="true">
  <svg viewBox="0 0 1100 900" preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="ringGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#6b82ee"/>
        <stop offset="55%" stop-color="#4d66e0"/>
        <stop offset="100%" stop-color="#3a4fc2"/>
      </linearGradient>
      <filter id="ringGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="9"/>
      </filter>
      <linearGradient id="hotV" x1="0.5" y1="0" x2="0.5" y2="1">
        <stop offset="0%" stop-color="#ff5470" stop-opacity="0.55"/>
        <stop offset="60%" stop-color="#ff5470" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#ff5470" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="warmV" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="#f59f3c" stop-opacity="0.55"/>
        <stop offset="60%" stop-color="#f59f3c" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#f59f3c" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="plumV" x1="1" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#b95ad8" stop-opacity="0.55"/>
        <stop offset="60%" stop-color="#b95ad8" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#b95ad8" stop-opacity="0"/>
      </linearGradient>
      <radialGradient id="shockHot"><stop offset="0%" stop-color="#ff5470" stop-opacity="0.65"/><stop offset="55%" stop-color="#ff5470" stop-opacity="0.18"/><stop offset="100%" stop-color="#ff5470" stop-opacity="0"/></radialGradient>
      <radialGradient id="shockWarm"><stop offset="0%" stop-color="#f59f3c" stop-opacity="0.65"/><stop offset="55%" stop-color="#f59f3c" stop-opacity="0.18"/><stop offset="100%" stop-color="#f59f3c" stop-opacity="0"/></radialGradient>
      <radialGradient id="shockPlum"><stop offset="0%" stop-color="#b95ad8" stop-opacity="0.65"/><stop offset="55%" stop-color="#b95ad8" stop-opacity="0.18"/><stop offset="100%" stop-color="#b95ad8" stop-opacity="0"/></radialGradient>
      <filter id="planeShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="8"/>
        <feOffset dx="0" dy="4" result="off"/>
        <feComponentTransfer><feFuncA type="linear" slope="0.18"/></feComponentTransfer>
        <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <g transform="translate(150 60)">
      <rect x="-92" y="-22" width="184" height="44" rx="22" fill="#ffffff" stroke="rgba(0,0,0,0.12)" stroke-width="1.2"/>
      <text x="0" y="6" text-anchor="middle" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="15" letter-spacing="0.22em" fill="#475569" font-weight="700">ZERO CODE</text>
    </g>
    <g transform="translate(950 60)">
      <rect x="-92" y="-22" width="184" height="44" rx="22" fill="#ffffff" stroke="rgba(0,0,0,0.12)" stroke-width="1.2"/>
      <text x="0" y="6" text-anchor="middle" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="15" letter-spacing="0.22em" fill="#475569" font-weight="700">ORG-WIDE</text>
    </g>

    <path d="M 480 10 L 620 10 L 580 224 L 520 224 Z" fill="url(#hotV)"/>
    <path d="M 30 770 L 30 880 L 246 668 L 198 622 Z" fill="url(#warmV)"/>
    <path d="M 1070 770 L 1070 880 L 854 668 L 902 622 Z" fill="url(#plumV)"/>

    <rect x="150" y="200" width="800" height="500" rx="170" fill="none" stroke="#4d66e0" stroke-opacity="0.16" stroke-width="1" stroke-dasharray="4 8"/>
    <rect x="172" y="222" width="756" height="456" rx="158" fill="none" stroke="#4d66e0" stroke-opacity="0.28" stroke-width="1"/>

    <rect x="200" y="250" width="700" height="400" rx="130" fill="none" stroke="#4d66e0" stroke-opacity="0.30" stroke-width="58" filter="url(#ringGlow)"/>
    <rect x="200" y="250" width="700" height="400" rx="130" fill="none" stroke="url(#ringGrad)" stroke-width="46"/>
    <rect x="200" y="250" width="700" height="400" rx="130" fill="none" stroke="#ffffff" stroke-opacity="0.22" stroke-width="1"/>

    <text x="550" y="257" text-anchor="middle" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="16" letter-spacing="0.28em" fill="#ffffff" font-weight="700">SCP · RCP · DATA PERIMETER</text>
    <text x="550" y="657" text-anchor="middle" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="16" letter-spacing="0.28em" fill="#ffffff" font-weight="700">GUARDRAIL · ENFORCED · ORG-WIDE</text>

    <g filter="url(#planeShadow)">
      <rect x="270" y="320" width="560" height="260" rx="20" fill="#ffffff" stroke="#4d66e0" stroke-opacity="0.35" stroke-width="1.4"/>
      <rect x="270" y="320" width="560" height="46" rx="20" fill="#4d66e0"/>
      <rect x="270" y="346" width="560" height="20" fill="#4d66e0"/>
      <text x="294" y="350" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="14" letter-spacing="0.26em" fill="#ffffff" font-weight="700">CLOUD CONTROL PLANE</text>
      <text x="788" y="350" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" letter-spacing="0.18em" fill="#ffffff" fill-opacity="0.85" font-weight="600">PROTECTED</text>
      <circle cx="800" cy="345" r="3.6" fill="#7be3b1"/>
      <circle cx="810" cy="345" r="3.6" fill="#7be3b1"/>
      <circle cx="820" cy="345" r="3.6" fill="#7be3b1"/>

      <g transform="translate(310 396)">
        <g stroke="#bcc5ec" stroke-width="1" fill="none" opacity="0.9">
          <path d="M 30 18 L 150 60 L 270 18 L 390 60 L 510 18"/>
          <path d="M 30 60 L 150 18 L 270 60 L 390 18 L 510 60"/>
          <path d="M 30 102 L 150 60 L 270 102 L 390 60 L 510 102"/>
          <path d="M 30 18 L 30 102"/>
          <path d="M 150 18 L 150 102"/>
          <path d="M 270 18 L 270 102"/>
          <path d="M 390 18 L 390 102"/>
          <path d="M 510 18 L 510 102"/>
        </g>
        <g>
          <circle cx="30" cy="18" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="150" cy="18" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="270" cy="18" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="390" cy="18" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="510" cy="18" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <rect x="22" y="52" width="16" height="16" rx="3" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <rect x="142" y="52" width="16" height="16" rx="3" fill="#4d66e0"/>
          <rect x="262" y="52" width="16" height="16" rx="3" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <rect x="382" y="52" width="16" height="16" rx="3" fill="#4d66e0"/>
          <rect x="502" y="52" width="16" height="16" rx="3" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="30" cy="102" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="150" cy="102" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="270" cy="102" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="390" cy="102" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
          <circle cx="510" cy="102" r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.6"/>
        </g>
      </g>

      <g>
        <circle cx="290" cy="556" r="4.5" fill="#22b07d"/>
        <text x="302" y="561" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" letter-spacing="0.18em" fill="#22b07d" font-weight="700">ENFORCED · 247 ACCOUNTS · 12 REGIONS</text>
        <text x="812" y="561" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="12" letter-spacing="0.16em" fill="#64748b" font-weight="600">04:31 AGO</text>
      </g>
    </g>

    <g>
      <line x1="550" y1="120" x2="550" y2="226" stroke="#ff5470" stroke-width="3" stroke-dasharray="8 6" stroke-linecap="round"/>
      <circle cx="550" cy="250" r="38" fill="url(#shockHot)"/>
      <g stroke="#ff5470" stroke-width="2.4" stroke-linecap="round" fill="none">
        <line x1="536" y1="236" x2="528" y2="228"/>
        <line x1="564" y1="236" x2="572" y2="228"/>
        <line x1="550" y1="232" x2="550" y2="220"/>
        <line x1="536" y1="264" x2="528" y2="272"/>
        <line x1="564" y1="264" x2="572" y2="272"/>
      </g>
      <g transform="translate(550 70)">
        <rect x="-160" y="-30" width="320" height="60" rx="30" fill="#ffffff" stroke="#ff5470" stroke-width="1.8"/>
        <text x="-138" y="-7" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" letter-spacing="0.20em" fill="#ff5470" font-weight="700">⚡ STOLEN CRED</text>
        <text x="-138" y="16" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" fill="#1d2f71" font-weight="600">denied · key inert</text>
        <text x="148" y="8" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="20" letter-spacing="-0.02em" fill="#ff5470" font-weight="700">×</text>
      </g>
    </g>

    <g>
      <line x1="148" y1="784" x2="252" y2="678" stroke="#f59f3c" stroke-width="3" stroke-dasharray="8 6" stroke-linecap="round"/>
      <circle cx="262" cy="668" r="38" fill="url(#shockWarm)"/>
      <g stroke="#f59f3c" stroke-width="2.4" stroke-linecap="round" fill="none">
        <line x1="248" y1="658" x2="238" y2="650"/>
        <line x1="278" y1="652" x2="288" y2="644"/>
        <line x1="262" y1="648" x2="262" y2="638"/>
        <line x1="248" y1="682" x2="238" y2="690"/>
        <line x1="278" y1="684" x2="288" y2="692"/>
      </g>
      <g transform="translate(160 832)">
        <rect x="-140" y="-30" width="320" height="60" rx="30" fill="#ffffff" stroke="#f59f3c" stroke-width="1.8"/>
        <text x="-118" y="-7" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" letter-spacing="0.20em" fill="#f59f3c" font-weight="700">◈ ROGUE AGENT</text>
        <text x="-118" y="16" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" fill="#1d2f71" font-weight="600">blocked · hits a wall</text>
        <text x="168" y="8" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="20" letter-spacing="-0.02em" fill="#f59f3c" font-weight="700">×</text>
      </g>
    </g>

    <g>
      <line x1="952" y1="784" x2="848" y2="678" stroke="#b95ad8" stroke-width="3" stroke-dasharray="8 6" stroke-linecap="round"/>
      <circle cx="838" cy="668" r="38" fill="url(#shockPlum)"/>
      <g stroke="#b95ad8" stroke-width="2.4" stroke-linecap="round" fill="none">
        <line x1="852" y1="658" x2="862" y2="650"/>
        <line x1="822" y1="652" x2="812" y2="644"/>
        <line x1="838" y1="648" x2="838" y2="638"/>
        <line x1="852" y1="682" x2="862" y2="690"/>
        <line x1="822" y1="684" x2="812" y2="692"/>
      </g>
      <g transform="translate(940 832)">
        <rect x="-180" y="-30" width="320" height="60" rx="30" fill="#ffffff" stroke="#b95ad8" stroke-width="1.8"/>
        <text x="-158" y="-7" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" letter-spacing="0.20em" fill="#b95ad8" font-weight="700">↗ PRIVILEGE DRIFT</text>
        <text x="-158" y="16" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="13" fill="#1d2f71" font-weight="600">no blast radius</text>
        <text x="128" y="8" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="20" letter-spacing="-0.02em" fill="#b95ad8" font-weight="700">×</text>
      </g>
    </g>

    <g transform="translate(550 740)">
      <rect x="-170" y="-24" width="340" height="48" rx="24" fill="#4d66e0"/>
      <text x="0" y="7" text-anchor="middle" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="16" letter-spacing="0.22em" fill="#ffffff" font-weight="700">MINUTES TO ENFORCED</text>
    </g>
  </svg>
</figure>

<style>
  .hero-wall {
    margin: 0;
    padding: 24px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 1rem;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 18px 40px -28px rgba(29, 47, 113, 0.18);
    width: 100%;
  }
  .hero-wall svg {
    display: block;
    width: 100%;
    height: auto;
    text-rendering: geometricPrecision;
    shape-rendering: geometricPrecision;
  }
  .hero-wall svg text {
    font-feature-settings: 'ss01', 'cv11';
    font-variant-ligatures: none;
  }
  @media (max-width: 640px) {
    .hero-wall { padding: 14px; border-radius: 0.875rem; }
  }
</style>
