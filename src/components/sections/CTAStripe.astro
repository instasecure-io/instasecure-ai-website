---
import Button from '@/components/ui/Button.astro';

interface Props {
  title: string;
  description?: string;
  supporting?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'brand' | 'light';
}
const { title, description, supporting, primaryCta, secondaryCta, variant = 'brand' } = Astro.props;
const sectionClass = variant === 'brand'
  ? 'bg-gradient-to-br from-[var(--color-brand)] via-[var(--color-brand)] to-[var(--color-accent)] text-white'
  : 'bg-slate-50 text-[var(--color-text)]';
const descClass = variant === 'brand' ? 'opacity-90' : 'text-slate-700';
const supportingClass = variant === 'brand' ? 'text-white/70' : 'text-slate-500';
const primaryVariant = variant === 'brand' ? 'ghost-on-brand' : 'accent';
---
<section class={sectionClass}>
  <div class="mx-auto max-w-5xl px-6 py-20 text-center">
    <h2 class="text-3xl md:text-4xl font-bold leading-tight">{title}</h2>
    {description && <p class={`mt-4 text-lg ${descClass}`}>{description}</p>}
    <div class="flex flex-wrap gap-4 justify-center mt-8">
      <Button href={primaryCta.href} variant={primaryVariant} size="lg">{primaryCta.label}</Button>
      {secondaryCta && (
        <Button href={secondaryCta.href} variant={variant === 'brand' ? 'secondary' : 'secondary'} size="lg">
          {secondaryCta.label}
        </Button>
      )}
    </div>
    {supporting && <p class={`mt-6 text-sm ${supportingClass}`}>{supporting}</p>}
  </div>
</section>
