---
export interface Stat {
  value: string;
  label: string;
  description?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  stats: Stat[];
  image?: { src: string; alt: string };
}
const { title, subtitle, stats, image } = Astro.props;
---
<section class="mx-auto max-w-7xl px-6 py-20">
  {(title || subtitle) && (
    <div class="mb-14 text-center max-w-3xl mx-auto">
      {title && <h2 class="text-3xl md:text-4xl font-bold">{title}</h2>}
      {subtitle && <p class="mt-4 text-lg text-slate-600">{subtitle}</p>}
    </div>
  )}
  <div class="grid md:grid-cols-3 gap-8">
    {stats.map(s => (
      <div class="text-center">
        <div class="text-5xl md:text-6xl font-bold text-[var(--color-brand)]">{s.value}</div>
        <div class="mt-3 font-semibold text-lg">{s.label}</div>
        {s.description && <p class="mt-2 text-sm text-slate-600 leading-relaxed">{s.description}</p>}
      </div>
    ))}
  </div>
  {image && (
    <div class="mt-14 flex justify-center">
      <img src={image.src} alt={image.alt} class="max-w-3xl w-full" />
    </div>
  )}
</section>
