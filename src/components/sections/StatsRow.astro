---
export interface Stat {
  value: string;
  label: string;
  description?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  stats: Stat[];
  image?: { src: string; alt: string };
}
const { title, subtitle, stats, image } = Astro.props;
---
<section class="mx-auto max-w-7xl px-6 py-20">
  {(title || subtitle) && (
    <div class="mb-14 text-center max-w-3xl mx-auto">
      {title && <h2 class="text-3xl md:text-5xl font-bold leading-[1.1] tracking-tight text-[var(--color-text)]">{title}</h2>}
      {subtitle && <p class="mt-5 text-lg md:text-xl text-slate-700 leading-relaxed">{subtitle}</p>}
    </div>
  )}
  <div class="grid md:grid-cols-3 gap-8">
    {stats.map(s => (
      <div class="text-center">
        <div class="text-6xl md:text-7xl font-bold text-[var(--color-brand)] leading-none tracking-tight">{s.value}</div>
        <div class="mt-4 font-bold text-xl text-[var(--color-text)]">{s.label}</div>
        {s.description && <p class="mt-3 text-[15px] text-slate-700 leading-relaxed max-w-xs mx-auto">{s.description}</p>}
      </div>
    ))}
  </div>
  {image && (
    <div class="mt-14 flex justify-center">
      <img src={image.src} alt={image.alt} class="max-w-3xl w-full" />
    </div>
  )}
</section>
