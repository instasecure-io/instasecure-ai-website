---
import Button from '@/components/ui/Button.astro';

export interface ProductTeaser {
  name: string;
  tagline: string;
  description: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  image?: { src: string; alt: string };
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  products: ProductTeaser[];
  columns?: 2 | 3;
}
import SectionHeader from './SectionHeader.astro';
const { eyebrow, title, subtitle, products, columns = 2 } = Astro.props;
const gridClass = columns === 3
  ? 'grid md:grid-cols-2 lg:grid-cols-3 gap-6'
  : 'grid md:grid-cols-2 gap-8';
const cardPadding = columns === 3 ? 'p-7 md:p-8' : 'p-8 md:p-10';
const taglineSize = columns === 3 ? 'text-xl md:text-2xl' : 'text-2xl md:text-3xl';
---
<section class="mx-auto max-w-7xl px-6 py-20">
  {(title || eyebrow) && (
    <div class="mb-14">
      <SectionHeader eyebrow={eyebrow} title={title!} subtitle={subtitle} />
    </div>
  )}
  <div class={gridClass}>
    {products.map(p => (
      <div class={`${cardPadding} rounded-2xl border border-black/5 bg-white shadow-sm flex flex-col`}>
        <div class="text-sm uppercase tracking-[0.15em] font-mono font-medium text-[var(--color-brand)]">{p.name}</div>
        <h3 class={`${taglineSize} font-bold mt-3 leading-tight tracking-tight text-[var(--color-text)]`}>{p.tagline}</h3>
        <p class="text-slate-700 mt-4 leading-relaxed text-[16px] flex-1">{p.description}</p>
        <div class="flex flex-wrap gap-3 mt-6">
          <Button href={p.primaryCta.href}>{p.primaryCta.label}</Button>
          {p.secondaryCta && (
            <a href={p.secondaryCta.href} class="inline-flex items-center gap-1 font-semibold text-[var(--color-brand)] hover:underline px-2 py-3">
              {p.secondaryCta.label} →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
