---
import Button from '@/components/ui/Button.astro';

export interface ProductTeaser {
  name: string;
  tagline: string;
  description: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  image?: { src: string; alt: string };
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  products: ProductTeaser[];
}
import SectionHeader from './SectionHeader.astro';
const { eyebrow, title, subtitle, products } = Astro.props;
---
<section class="mx-auto max-w-7xl px-6 py-20">
  {(title || eyebrow) && (
    <div class="mb-14">
      <SectionHeader eyebrow={eyebrow} title={title!} subtitle={subtitle} />
    </div>
  )}
  <div class="grid md:grid-cols-2 gap-8">
    {products.map(p => (
      <div class="p-8 md:p-10 rounded-2xl border border-black/5 bg-white shadow-sm">
        <div class="text-xs uppercase tracking-[0.2em] font-bold text-[var(--color-brand)]">{p.name}</div>
        <h3 class="text-2xl md:text-3xl font-bold mt-3 leading-tight">{p.tagline}</h3>
        <p class="text-slate-700 mt-4 leading-relaxed">{p.description}</p>
        <div class="flex flex-wrap gap-3 mt-6">
          <Button href={p.primaryCta.href}>{p.primaryCta.label}</Button>
          {p.secondaryCta && (
            <a href={p.secondaryCta.href} class="inline-flex items-center gap-1 font-semibold text-[var(--color-brand)] hover:underline px-2 py-3">
              {p.secondaryCta.label} →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
