---
export interface Badge {
  src: string;
  alt: string;
  href?: string;
  height?: number;
}

interface Props {
  title?: string;
  badges: Badge[];
}
const { title = 'Proud AWS partner', badges } = Astro.props;
---
<section class="bg-[var(--color-text)] text-white py-14">
  <div class="mx-auto max-w-7xl px-6 text-center">
    {title && <div class="text-sm uppercase tracking-[0.15em] font-semibold text-white/90 mb-8">{title}</div>}
    <div class="flex flex-wrap gap-10 md:gap-16 justify-center items-center">
      {badges.map(b => {
        const img = <img src={b.src} alt={b.alt} class="object-contain" style={`height: ${b.height ?? 56}px;`} />;
        return b.href
          ? <a href={b.href} target="_blank" rel="noopener" class="hover:opacity-80 transition">{img}</a>
          : <div>{img}</div>;
      })}
    </div>
  </div>
</section>
