---
export interface Badge {
  src: string;
  alt: string;
  href?: string;
  height?: number;
  width?: number;
  intrinsicWidth?: number;
  intrinsicHeight?: number;
}

interface Props {
  title?: string;
  badges: Badge[];
  variant?: 'dark' | 'light';
}
const { title = 'Proud AWS partner', badges, variant = 'dark' } = Astro.props;
const sectionClass = variant === 'dark'
  ? 'bg-[var(--color-text)] text-white'
  : 'bg-slate-50 text-[var(--color-text)]';
const titleClass = variant === 'dark'
  ? 'font-semibold text-white/90'
  : 'font-mono font-medium text-[var(--color-brand)]';
---
<section class={`${sectionClass} py-14`}>
  <div class="mx-auto max-w-7xl px-6 text-center">
    {title && <div class={`text-sm uppercase tracking-[0.15em] mb-8 ${titleClass}`}>{title}</div>}
    <div class="flex flex-wrap gap-10 md:gap-16 justify-center items-center">
      {badges.map(b => {
        const renderedHeight = b.height ?? 56;
        const aspect = b.intrinsicWidth && b.intrinsicHeight ? b.intrinsicWidth / b.intrinsicHeight : 1;
        const renderedWidth = Math.round(renderedHeight * aspect);
        const img = <img
          src={b.src}
          alt={b.alt}
          width={renderedWidth}
          height={renderedHeight}
          loading="lazy"
          decoding="async"
          class="object-contain"
          style={`height: ${renderedHeight}px; width: ${renderedWidth}px;`}
        />;
        return b.href
          ? <a href={b.href} target="_blank" rel="noopener" class="hover:opacity-80 transition">{img}</a>
          : <div>{img}</div>;
      })}
    </div>
  </div>
</section>
