---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, subtitle, align = 'center', class: klass = '' } = Astro.props;
const alignment = align === 'center' ? 'text-center items-center mx-auto' : 'text-left';
---
<div class={`max-w-3xl ${alignment} ${klass}`}>
  {eyebrow && <div class="text-xs uppercase tracking-[0.2em] font-bold text-[var(--color-brand)] mb-4">{eyebrow}</div>}
  <h2 class="text-3xl md:text-4xl font-bold leading-tight">{title}</h2>
  {subtitle && <p class="mt-4 text-lg text-slate-600">{subtitle}</p>}
</div>
