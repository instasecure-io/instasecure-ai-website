---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, subtitle, align = 'center', class: klass = '' } = Astro.props;
const alignment = align === 'center' ? 'text-center items-center mx-auto' : 'text-left';
---
<div class={`max-w-3xl ${alignment} ${klass}`}>
  {eyebrow && <div class="text-sm uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-4">{eyebrow}</div>}
  <h2 class="text-3xl md:text-5xl font-bold leading-[1.1] tracking-tight text-[var(--color-text)]">{title}</h2>
  {subtitle && <p class="mt-5 text-lg md:text-xl text-slate-700 leading-relaxed">{subtitle}</p>}
</div>
