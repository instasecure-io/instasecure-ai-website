---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  bullets?: string[];
  image: { src: string; alt: string };
  imagePosition?: 'left' | 'right';
}
const { eyebrow, title, description, bullets, image, imagePosition = 'right' } = Astro.props;
---
<section class="py-14">
  <div class="mx-auto max-w-7xl px-6 grid md:grid-cols-2 gap-12 items-center">
    {imagePosition === 'left' && (
      <img src={image.src} alt={image.alt} class="w-full rounded-2xl shadow-lg" loading="lazy" />
    )}
    <div>
      {eyebrow && <div class="text-sm uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-3">{eyebrow}</div>}
      <h3 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] tracking-tight leading-tight">{title}</h3>
      {description && <p class="mt-4 text-[17px] text-slate-700 leading-relaxed">{description}</p>}
      {bullets && (
        <ul class="mt-5 space-y-3">
          {bullets.map(b => (
            <li class="flex gap-3 text-[16px] text-slate-800 leading-relaxed">
              <span class="text-[var(--color-accent)] font-bold shrink-0">▸</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
    {imagePosition === 'right' && (
      <img src={image.src} alt={image.alt} class="w-full rounded-2xl shadow-lg" loading="lazy" />
    )}
  </div>
</section>
