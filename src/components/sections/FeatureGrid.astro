---
import IconBadge from '@/components/ui/IconBadge.astro';
import SectionHeader from './SectionHeader.astro';

export interface Feature {
  icon?: string;         // lucide:* name (e.g. "lucide:shield-check")
  iconColor?: 'brand' | 'accent' | 'navy' | 'brand-tint' | 'accent-tint';
  title: string;
  description?: string;
  bullets?: string[];
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  features: Feature[];
  columns?: 2 | 3 | 4;
  variant?: 'plain' | 'cards';
  class?: string;
}
const { eyebrow, title, subtitle, features, columns = 3, variant = 'cards', class: klass = '' } = Astro.props;
const gridClass = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4' }[columns];
const cardClass = variant === 'cards'
  ? 'p-8 rounded-2xl border border-black/5 bg-white shadow-sm hover:shadow-md transition'
  : '';
---
<section class={`mx-auto max-w-7xl px-6 py-20 ${klass}`}>
  {(title || eyebrow) && (
    <div class="mb-14">
      <SectionHeader eyebrow={eyebrow} title={title!} subtitle={subtitle} />
    </div>
  )}
  <div class={`grid gap-6 md:gap-8 ${gridClass}`}>
    {features.map(f => (
      <div class={cardClass}>
        {f.icon && (
          <div class="mb-5">
            <IconBadge name={f.icon} color={f.iconColor ?? 'brand'} size="md" />
          </div>
        )}
        <h3 class="font-bold text-xl text-[var(--color-text)] leading-snug tracking-tight">{f.title}</h3>
        {f.description && <p class="text-slate-700 mt-3 leading-relaxed text-[16px]">{f.description}</p>}
        {f.bullets && (
          <ul class="mt-5 space-y-2.5">
            {f.bullets.map(b => (
              <li class="flex gap-2.5 text-[15px] text-slate-800 leading-snug">
                <span class="text-[var(--color-accent)] font-bold shrink-0">▸</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</section>
