---
// Converging-vectors illustration for "The shift" section: three
// vectors (attackers automated · defenders drowned · detection lost
// economics) bearing down on a "Cloud Control Plane" surface, with
// before/after multipliers (100×, 10×, 100×) on each.
//
// No headline / lede inside — those live on the page (SectionHeader).
// Polished to match the site: drop the JetBrains Mono explicit font
// reference (inherits from body/mono fallback chain), ink + faint
// fills swap to var(--color-text) / slate-500, card chrome aligned
// with the site's rounded-2xl + slate shadow convention. Vector
// hues (#ff5470 / #f59f3c / #b95ad8) and brand indigo stay literal —
// signal content, not chrome.
---
<figure class="shift-illo">
  <svg viewBox="0 0 1100 640" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Three forces — attackers automated, defenders drowned, detection lost economics — converging on the cloud control plane.">
    <defs>
      <linearGradient id="shiftHotVec" x1="0.5" y1="0" x2="0.5" y2="1">
        <stop offset="0%" stop-color="#ff5470" stop-opacity="0.55"/>
        <stop offset="60%" stop-color="#ff5470" stop-opacity="0.30"/>
        <stop offset="100%" stop-color="#ff5470" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="shiftWarmVec" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="#f59f3c" stop-opacity="0.50"/>
        <stop offset="60%" stop-color="#f59f3c" stop-opacity="0.28"/>
        <stop offset="100%" stop-color="#f59f3c" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="shiftPlumVec" x1="1" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#b95ad8" stop-opacity="0.50"/>
        <stop offset="60%" stop-color="#b95ad8" stop-opacity="0.28"/>
        <stop offset="100%" stop-color="#b95ad8" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="shiftPlaneFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ffffff"/>
        <stop offset="100%" stop-color="#f5f7fd"/>
      </linearGradient>
      <marker id="shiftArrHot" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M 1 1 L 11 6 L 1 11 Z" fill="#ff5470"/>
      </marker>
      <marker id="shiftArrWarm" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M 1 1 L 11 6 L 1 11 Z" fill="#f59f3c"/>
      </marker>
      <marker id="shiftArrPlum" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M 1 1 L 11 6 L 1 11 Z" fill="#b95ad8"/>
      </marker>
      <filter id="shiftPlaneShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="10"/>
        <feOffset dx="0" dy="6" result="off"/>
        <feComponentTransfer><feFuncA type="linear" slope="0.18"/></feComponentTransfer>
        <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <path d="M 350 6 L 750 6 L 620 290 L 480 290 Z" fill="url(#shiftHotVec)"/>
    <path d="M 16 478 L 16 632 L 388 488 L 320 392 Z" fill="url(#shiftWarmVec)"/>
    <path d="M 1084 478 L 1084 632 L 712 488 L 780 392 Z" fill="url(#shiftPlumVec)"/>

    <rect x="270" y="220" width="560" height="240" rx="22" fill="#ffffff" stroke="none" filter="url(#shiftPlaneShadow)"/>
    <g>
      <rect x="270" y="220" width="560" height="240" rx="22" fill="url(#shiftPlaneFill)" stroke="#4d66e0" stroke-width="1.6"/>
      <rect x="278" y="228" width="544" height="224" rx="16" fill="none" stroke="rgba(0,0,0,0.05)" stroke-width="1"/>

      <g>
        <rect x="270" y="220" width="560" height="36" rx="22" fill="#4d66e0"/>
        <rect x="270" y="240" width="560" height="16" fill="#4d66e0"/>
        <text x="294" y="243" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="10.5" letter-spacing="0.30em" fill="#ffffff" font-weight="700">CLOUD CONTROL PLANE</text>
        <circle cx="640" cy="239" r="3" fill="#ff5470"/>
        <circle cx="650" cy="239" r="3" fill="#f59f3c"/>
        <circle cx="660" cy="239" r="3" fill="#b95ad8"/>
        <text x="806" y="243" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="10" letter-spacing="0.18em" fill="#ffffff" fill-opacity="0.72" font-weight="500">IAM · SCP · POLICY</text>
      </g>

      <g transform="translate(310 286)">
        <g stroke="#bcc5ec" stroke-width="1" fill="none" opacity="0.9">
          <path d="M 30 18 L 150 60 L 270 18 L 390 60"/>
          <path d="M 30 60 L 150 18 L 270 60 L 390 18"/>
          <path d="M 30 102 L 150 60 L 270 102 L 390 60"/>
          <path d="M 30 18 L 30 102"/>
          <path d="M 150 18 L 150 102"/>
          <path d="M 270 18 L 270 102"/>
          <path d="M 390 18 L 390 102"/>
        </g>
        <g font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="9" fill="#475569" letter-spacing="0.06em" font-weight="600">
          <g transform="translate(30 18)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">IAM-ROLE</text></g>
          <g transform="translate(150 18)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">SVC-ACCT</text></g>
          <g transform="translate(270 18)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">PIPELINE</text></g>
          <g transform="translate(390 18)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">3RD-PTY</text></g>
          <g transform="translate(30 60)"><rect x="-9" y="-9" width="18" height="18" rx="3" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">TRUST</text></g>
          <g transform="translate(150 60)"><rect x="-9" y="-9" width="18" height="18" rx="3" fill="#4d66e0"/><text x="14" y="3">POLICY</text></g>
          <g transform="translate(270 60)"><rect x="-9" y="-9" width="18" height="18" rx="3" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">SCP</text></g>
          <g transform="translate(390 60)"><rect x="-9" y="-9" width="18" height="18" rx="3" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">PERMS</text></g>
          <g transform="translate(30 102)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">HUMAN</text></g>
          <g transform="translate(150 102)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">AGENT</text></g>
          <g transform="translate(270 102)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">FEDERATED</text></g>
          <g transform="translate(390 102)"><circle r="9" fill="#ffffff" stroke="#4d66e0" stroke-width="1.4"/><text x="14" y="3">EXTERNAL</text></g>
        </g>
      </g>

      <text x="294" y="434" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="10" letter-spacing="0.18em" fill="#64748b" font-weight="500">EVERY ACCOUNT · REGION · IDENTITY</text>
      <text x="806" y="434" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="10" letter-spacing="0.18em" fill="#64748b" font-weight="500">↳ THIS IS THE SURFACE</text>
    </g>

    <line x1="550" y1="60" x2="550" y2="216" stroke="#ff5470" stroke-width="2.4" stroke-linecap="round" marker-end="url(#shiftArrHot)"/>
    <g transform="translate(550 30)">
      <rect x="-150" y="-22" width="300" height="44" rx="22" fill="#ffffff" stroke="#ff5470" stroke-width="1.6"/>
      <text x="-128" y="-2" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="10" letter-spacing="0.24em" fill="#ff5470" font-weight="700">01 · ATTACKERS AUTOMATED</text>
      <text x="-128" y="14" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="11" fill="#1d2f71" font-weight="500">
        <tspan fill="#64748b">weeks</tspan> <tspan fill="#cbd5e1">→</tspan> <tspan fill="#ff5470" font-weight="700">minutes</tspan>
      </text>
      <text x="142" y="6" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="14" letter-spacing="-0.02em" fill="#ff5470" font-weight="700">100×</text>
    </g>

    <line x1="160" y1="556" x2="296" y2="464" stroke="#f59f3c" stroke-width="2.4" stroke-linecap="round" marker-end="url(#shiftArrWarm)"/>
    <g transform="translate(160 580)">
      <rect x="-148" y="-22" width="296" height="44" rx="22" fill="#ffffff" stroke="#f59f3c" stroke-width="1.6"/>
      <text x="-126" y="-2" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="10" letter-spacing="0.24em" fill="#f59f3c" font-weight="700">02 · DEFENDERS DROWNED</text>
      <text x="-126" y="14" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="11" fill="#1d2f71" font-weight="500">
        <tspan fill="#64748b">1 : 5</tspan> <tspan fill="#cbd5e1">→</tspan> <tspan fill="#f59f3c" font-weight="700">1 : 50</tspan>
      </text>
      <text x="140" y="6" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="14" letter-spacing="-0.02em" fill="#f59f3c" font-weight="700">10×</text>
    </g>

    <line x1="940" y1="556" x2="804" y2="464" stroke="#b95ad8" stroke-width="2.4" stroke-linecap="round" marker-end="url(#shiftArrPlum)"/>
    <g transform="translate(940 580)">
      <rect x="-150" y="-22" width="300" height="44" rx="22" fill="#ffffff" stroke="#b95ad8" stroke-width="1.6"/>
      <text x="-128" y="-2" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="10" letter-spacing="0.24em" fill="#b95ad8" font-weight="700">03 · DETECTION LOST ECONOMICS</text>
      <text x="-128" y="14" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="11" fill="#1d2f71" font-weight="500">
        <tspan fill="#64748b">days</tspan> <tspan fill="#cbd5e1">→</tspan> <tspan fill="#b95ad8" font-weight="700">minutes</tspan>
      </text>
      <text x="142" y="6" text-anchor="end" font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="14" letter-spacing="-0.02em" fill="#b95ad8" font-weight="700">100×</text>
    </g>

    <g fill="none" stroke="#4d66e0" stroke-opacity="0.10">
      <rect x="258" y="208" width="584" height="264" rx="28" stroke-width="1"/>
      <rect x="246" y="196" width="608" height="288" rx="34" stroke-width="1"/>
    </g>
  </svg>
</figure>

<style>
  .shift-illo {
    margin: 0;
    padding: 28px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 1rem; /* rounded-2xl */
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 18px 40px -28px rgba(29, 47, 113, 0.18);
  }
  .shift-illo svg {
    display: block;
    width: 100%;
    height: auto;
    text-rendering: geometricPrecision;
    shape-rendering: geometricPrecision;
  }
  .shift-illo svg text {
    font-feature-settings: 'ss01', 'cv11';
    font-variant-ligatures: none;
  }
  @media (max-width: 640px) {
    .shift-illo { padding: 16px; border-radius: 0.875rem; }
  }
</style>
