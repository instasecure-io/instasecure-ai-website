---
import SectionHeader from './SectionHeader.astro';

export interface Testimonial {
  quote: string;
  name: string;
  title: string;
  company?: string;
}

interface Props {
  testimonials: Testimonial[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}
const { testimonials, eyebrow, title, subtitle } = Astro.props;
---
<section class="mx-auto max-w-7xl px-6 py-20">
  {(title || eyebrow) && (
    <div class="mb-14">
      <SectionHeader eyebrow={eyebrow} title={title!} subtitle={subtitle} />
    </div>
  )}
  <div class="grid md:grid-cols-2 gap-8">
    {testimonials.map(t => (
      <figure class="p-8 md:p-10 rounded-2xl bg-slate-50 border border-black/5">
        <svg width="36" height="24" viewBox="0 0 36 24" fill="none" class="text-[var(--color-brand)] mb-4" aria-hidden="true">
          <path d="M14 0H0v14c0 5.523 4.477 10 10 10v-4c-3.314 0-6-2.686-6-6V10h10V0zm22 0H22v14c0 5.523 4.477 10 10 10v-4c-3.314 0-6-2.686-6-6V10h10V0z" fill="currentColor"/>
        </svg>
        <blockquote class="text-lg md:text-xl leading-relaxed text-[var(--color-text)] font-medium">"{t.quote}"</blockquote>
        <figcaption class="mt-6">
          <div class="font-bold text-[var(--color-text)]">{t.name}</div>
          <div class="text-sm text-slate-700 mt-0.5">{t.title}{t.company ? `, ${t.company}` : ''}</div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
