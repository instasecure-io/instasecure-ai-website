---
export interface Crumb { label: string; href?: string; }
interface Props { crumbs: Crumb[]; }
const { crumbs } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://instasecure.ai';
const currentPageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const itemListElement = crumbs.map((c, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: c.label,
  item: c.href
    ? (c.href.startsWith('http') ? c.href : `${siteUrl}${c.href}`)
    : currentPageUrl,
}));
---
<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-6 pt-6 text-sm text-slate-600">
  <ol class="flex gap-2 flex-wrap">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        {c.href ? (
          <a href={c.href} class="font-medium hover:text-[var(--color-brand)] transition">{c.label}</a>
        ) : (
          <span class="font-semibold text-[var(--color-text)]" aria-current="page">{c.label}</span>
        )}
        {i < crumbs.length - 1 && <span class="opacity-50" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement,
})} />
