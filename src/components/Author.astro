---
import { AUTHORS } from '@/data/authors';
import { Icon } from 'astro-icon/components';

interface Props { id: string; variant?: 'inline' | 'card'; }
const { id, variant = 'card' } = Astro.props;
const a = AUTHORS[id];
if (!a) throw new Error(`Author not found: ${id}. Add to src/data/authors.ts.`);

function initials(name: string) {
  return name.split(/\s+/).map(n => n[0]).slice(0, 2).join('');
}
---
{variant === 'inline' ? (
  <div class="flex gap-3 items-center">
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[var(--color-brand)] to-[var(--color-accent)] text-white font-bold text-sm flex items-center justify-center shrink-0">{initials(a.name)}</div>
    <div>
      <div class="font-semibold text-sm text-[var(--color-text)]">{a.name}</div>
      <div class="text-xs text-slate-600">{a.title}</div>
    </div>
  </div>
) : (
  <div class="mt-12 p-6 rounded-2xl bg-slate-50 border border-black/5 flex gap-5 items-start">
    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--color-brand)] to-[var(--color-accent)] text-white font-bold text-xl flex items-center justify-center shrink-0">{initials(a.name)}</div>
    <div class="flex-1">
      <div class="text-xs uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-1">Written by</div>
      <div class="font-bold text-lg text-[var(--color-text)]">{a.name}</div>
      <div class="text-sm text-slate-600 mt-0.5">{a.title}</div>
      <p class="text-[15px] text-slate-700 mt-3 leading-relaxed">{a.bio}</p>
      {a.linkedin && (
        <a href={a.linkedin} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-brand)] hover:underline">
          <Icon name="lucide:linkedin" width="16" height="16" />
          Connect on LinkedIn
        </a>
      )}
    </div>
  </div>
)}
