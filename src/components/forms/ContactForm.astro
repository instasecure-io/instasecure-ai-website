---
interface Props {
  subject?: string;
  submitLabel?: string;
  showCompany?: boolean;
  messagePlaceholder?: string;
}
const {
  subject = 'New contact form submission',
  submitLabel = 'Send message',
  showCompany = true,
  messagePlaceholder = 'Tell us about your cloud security needs…',
} = Astro.props;
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID;
const action = formspreeId ? `https://formspree.io/f/${formspreeId}` : '#';
---
<form
  action={action}
  method="POST"
  class="max-w-2xl mx-auto space-y-5 p-8 md:p-10 rounded-2xl bg-white border border-black/5 shadow-sm"
>
  <div class="grid md:grid-cols-2 gap-5">
    <label class="block">
      <span class="text-sm font-semibold text-[var(--color-text)]">Name</span>
      <input name="name" required
        class="mt-1.5 w-full rounded-lg border border-black/10 px-4 py-3 text-[15px] outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/20 transition"
      />
    </label>
    <label class="block">
      <span class="text-sm font-semibold text-[var(--color-text)]">Email</span>
      <input type="email" name="email" required
        class="mt-1.5 w-full rounded-lg border border-black/10 px-4 py-3 text-[15px] outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/20 transition"
      />
    </label>
  </div>
  {showCompany && (
    <label class="block">
      <span class="text-sm font-semibold text-[var(--color-text)]">Company</span>
      <input name="company"
        class="mt-1.5 w-full rounded-lg border border-black/10 px-4 py-3 text-[15px] outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/20 transition"
      />
    </label>
  )}
  <label class="block">
    <span class="text-sm font-semibold text-[var(--color-text)]">Message</span>
    <textarea name="message" rows="5" required placeholder={messagePlaceholder}
      class="mt-1.5 w-full rounded-lg border border-black/10 px-4 py-3 text-[15px] outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/20 transition resize-y"
    />
  </label>
  <input type="hidden" name="_subject" value={subject} />
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
  <button type="submit"
    class="inline-flex items-center gap-2 rounded-full px-8 py-4 bg-[var(--color-accent)] text-white font-semibold hover:opacity-90 shadow-md shadow-[var(--color-accent)]/25 transition text-base"
  >
    {submitLabel} →
  </button>
</form>
