---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import CTAStripe from '@/components/sections/CTAStripe.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import StructuredData from '@/components/seo/StructuredData.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heroTitle: string;
  heroDescription: string;
  heroPrimaryCta?: { label: string; href: string };
  heroSecondaryCta?: { label: string; href: string };
  heroImage?: { src: string; alt: string };
  closingCtaTitle?: string;
  closingCtaDescription?: string;
  breadcrumbCategory?: { label: string; href?: string };
}
const {
  title,
  description,
  eyebrow = 'Use Case',
  heroTitle,
  heroDescription,
  heroPrimaryCta,
  heroSecondaryCta,
  heroImage,
  closingCtaTitle = 'Ready to Build a Safer Cloud?',
  closingCtaDescription = 'Cloud teams like yours are already seeing results in weeks. You could be next.',
  breadcrumbCategory = { label: 'Use Cases' },
} = Astro.props;

const AWS_MARKETPLACE = 'https://aws.amazon.com/marketplace/pp/prodview-kmlldyula7axs?sr=0-1&ref_=beagle&applicationId=AWSMPContessa';
const CALENDLY = import.meta.env.PUBLIC_CALENDLY_DEMO_URL;

const crumbs = [
  { label: 'Home', href: '/' },
  breadcrumbCategory,
  { label: heroTitle },
];

// Mirror the visible breadcrumbs into a BreadcrumbList JSON-LD so SERPs
// can render the breadcrumb path under the result. The trailing item
// (current page) doesn't get an `item` URL per Google's spec.
const siteOrigin = Astro.site ? Astro.site.origin : 'https://instasecure.ai';
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => {
    const item: any = {
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
    };
    if (i === crumbs.length - 1) {
      item.item = currentUrl;
    } else if (c.href) {
      item.item = new URL(c.href, siteOrigin).toString();
    }
    return item;
  }),
};
---
<BaseLayout {title} {description}>
  <StructuredData slot="head" data={breadcrumbSchema} />
  <Breadcrumbs crumbs={crumbs} />

  <Hero
    eyebrow={eyebrow}
    title={heroTitle}
    description={heroDescription}
    primaryCta={heroPrimaryCta ?? { label: 'Start Free Trial', href: AWS_MARKETPLACE }}
    secondaryCta={heroSecondaryCta ?? { label: 'Book a Demo', href: CALENDLY }}
    image={heroImage}
  />

  <slot />

  <CTAStripe
    title={closingCtaTitle}
    description={closingCtaDescription}
    supporting="Choose your path — self-serve on AWS Marketplace or schedule a personalized walkthrough."
    primaryCta={{ label: 'Start Free Trial', href: AWS_MARKETPLACE }}
    secondaryCta={{ label: 'Book a Demo', href: CALENDLY }}
  />
</BaseLayout>
