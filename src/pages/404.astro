---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import IconBadge from '@/components/ui/IconBadge.astro';

const popularPaths = [
  { label: 'Homepage', href: '/', description: 'Start here' },
  { label: 'InstaAccess', href: '/instaaccess', description: 'Non-human identity hardening' },
  { label: 'InstaWorkforce', href: '/instaworkforce', description: 'Human access governance' },
  { label: 'How It Works', href: '/howitworks', description: 'Platform overview' },
  { label: 'Pricing', href: '/pricing', description: 'Request a quote' },
  { label: 'Contact', href: '/contact', description: 'Get in touch' },
];
---
<BaseLayout
  title="Page not found · 404 | InstaSecure"
  description="The page you're looking for doesn't exist. Here are some popular pages to help you find what you need."
  noindex
>
  <section class="mx-auto max-w-4xl px-6 py-24 text-center">
    <div class="mx-auto mb-8 w-20 h-20 rounded-2xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex items-center justify-center">
      <IconBadge name="lucide:compass" color="accent" size="lg" />
    </div>
    <div class="text-sm uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-4">Error 404</div>
    <h1 class="text-5xl md:text-7xl font-bold text-[var(--color-text)] leading-tight tracking-tight">Page not found</h1>
    <p class="mt-6 text-lg md:text-xl text-slate-700 max-w-2xl mx-auto leading-relaxed">
      The page you're looking for may have moved, been renamed, or never existed. Try one of the links below — or head back to the homepage.
    </p>
    <a href="/" class="mt-10 inline-flex items-center gap-2 rounded-full px-8 py-4 bg-[var(--color-accent)] text-white font-semibold hover:opacity-90 shadow-md shadow-[var(--color-accent)]/25 transition">
      Go to homepage →
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="text-xs uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-6 text-center">Popular destinations</div>
    <div class="grid md:grid-cols-3 gap-4">
      {popularPaths.map(p => (
        <a href={p.href} class="p-6 rounded-2xl border border-black/5 bg-white hover:shadow-md hover:-translate-y-0.5 transition">
          <div class="font-bold text-[var(--color-text)]">{p.label}</div>
          <div class="text-sm text-slate-600 mt-1">{p.description}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
