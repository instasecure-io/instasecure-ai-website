---
import UseCaseLayout from '@/layouts/UseCaseLayout.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';

type Category = 'defend' | 'blast-radius' | 'govern';

interface UseCase {
  category: Category;
  icon: string;
  iconColor: 'brand' | 'accent';
  title: string;
  risk: string;
  solutions: string[];
}

const CATEGORIES: Record<Category, { eyebrow: string; title: string; subtitle: string }> = {
  defend: {
    eyebrow: 'Defend Against Attacks',
    title: 'Stop active cloud threats',
    subtitle: 'Block data exfiltration, credential compromise, privilege escalation, and lateral movement — with preventive controls that work at the organizational plane.',
  },
  'blast-radius': {
    eyebrow: 'Reduce Blast Radius',
    title: 'Contain compromise and shrink attack surface',
    subtitle: 'Make sure a compromised workload can only access what it genuinely needs — and surface unused wildcards for safe right-sizing.',
  },
  govern: {
    eyebrow: 'Govern & Comply',
    title: 'Evidence-ready IAM governance',
    subtitle: 'Keep machine identities clean, ownership clear, and compliance frameworks mapped — with audit trails generated automatically.',
  },
};

const useCases: UseCase[] = [
  {
    category: 'defend',
    icon: 'lucide:download',
    iconColor: 'accent',
    title: 'Data Exfiltration via Machine Roles',
    risk: 'Lambda functions, EC2 roles, or pipelines with excessive access to S3 or KMS can be exploited to exfiltrate sensitive data.',
    solutions: [
      'Identify non-human identities with direct or indirect access to sensitive data stores',
      'Detect encryption gaps and flag roles with unscoped KMS decrypt permissions',
      'Recommend policy conditions (VPC, IP, PrincipalOrgID) and integrate with CloudTrail for actual usage',
    ],
  },
  {
    category: 'defend',
    icon: 'lucide:git-branch',
    iconColor: 'brand',
    title: 'Lateral Movement Across Environments',
    risk: 'Workloads with cross-account trust can be used to move laterally from dev to prod — or from a compromised environment to a production one.',
    solutions: [
      'Map trust policies and surface cross-account role assumption paths',
      'Flag risky role assumptions with wildcard or overly broad principal conditions',
      'Enforce tighter trust policies with SCPs and PrincipalOrgID conditions',
    ],
  },
  {
    category: 'defend',
    icon: 'lucide:arrow-up-right',
    iconColor: 'accent',
    title: 'Privilege Escalation in Workloads',
    risk: 'A compromised or misconfigured machine identity may assume admin roles or grant itself more permissions.',
    solutions: [
      'Detect toxic combinations (iam:CreateRole + iam:AttachPolicy, PassRole + lambda:CreateFunction)',
      'Alert on assume-role permissions with wildcard principals',
      'Apply permission boundaries to all machine identities',
    ],
  },
  {
    category: 'defend',
    icon: 'lucide:key',
    iconColor: 'brand',
    title: 'Credential Exposure in CI/CD and Runtime',
    risk: 'Hardcoded or long-lived credentials in pipelines or containers can be exploited by attackers who access logs, images, or source.',
    solutions: [
      'Detect IAM users and static access keys still in use',
      'Recommend migration to IAM roles with short-lived tokens (IRSA, IMDS v2, OIDC)',
      'Monitor CloudTrail for key usage patterns and flag anomalies',
    ],
  },
  {
    category: 'blast-radius',
    icon: 'lucide:activity',
    iconColor: 'accent',
    title: 'Unauthorized API Activity via Service Roles',
    risk: 'Machine roles with broad access to AWS services may be abused to manipulate infrastructure — spin up resources, delete logs, modify config.',
    solutions: [
      'Analyze API call patterns per role via CloudTrail',
      'Flag over-provisioned roles where granted ≫ used permissions',
      'Right-size access to observed usage',
    ],
  },
  {
    category: 'blast-radius',
    icon: 'lucide:shield',
    iconColor: 'brand',
    title: 'Blast Radius Reduction for Workload Compromise',
    risk: 'A compromised function or container role can access multiple services, regions, or accounts unless its reach is explicitly limited.',
    solutions: [
      'Enforce regional conditions and service-specific resource ARNs',
      'Detect high-privilege roles attached to low-trust workloads',
      'Apply SCPs to contain compromise within a blast-radius boundary',
    ],
  },
  {
    category: 'blast-radius',
    icon: 'lucide:minimize-2',
    iconColor: 'accent',
    title: 'Reducing Attack Surface of Non-Human Identities',
    risk: 'Default or legacy roles often carry permissions no longer needed — wildcards from faster-times that never got pruned.',
    solutions: [
      'Scan for unused permissions per role',
      'Highlight wildcards (Action: *, Resource: *) that could be scoped',
      'Provide actionable, testable right-sizing recommendations',
    ],
  },
  {
    category: 'govern',
    icon: 'lucide:split',
    iconColor: 'brand',
    title: 'Segregation of Duties in Automation Pipelines',
    risk: 'A single machine identity with build, deploy, and modify permissions violates separation of duties and creates a dangerous single point of compromise.',
    solutions: [
      'Detect conflicting permission combinations in one identity',
      'Recommend role decomposition into narrower functions',
      'Enforce pipeline isolation using accounts and SCPs',
    ],
  },
  {
    category: 'govern',
    icon: 'lucide:file-check',
    iconColor: 'accent',
    title: 'Compliance-Ready Controls for Non-Human Access',
    risk: 'Regulatory frameworks (SOC 2, PCI-DSS, HIPAA) increasingly require machine identity governance — not just human access reviews.',
    solutions: [
      'Audit trails for every machine identity and its permissions',
      'Evidence generation for compliance auditors on demand',
      'Compliance mapping from each control to the relevant framework clause',
    ],
  },
  {
    category: 'govern',
    icon: 'lucide:sparkles',
    iconColor: 'brand',
    title: 'Governance and Policy Hygiene for Machine Access',
    risk: 'Stale, duplicate, or orphaned roles introduce unnecessary risk and complexity — cluttering your IAM and creating attack paths.',
    solutions: [
      'Identify unused roles based on CloudTrail activity',
      'Track proliferation: how many roles, how many duplicates, where ownership is missing',
      'Suggest cleanup with safe archival before delete',
    ],
  },
];

const categoryOrder: Category[] = ['defend', 'blast-radius', 'govern'];
const grouped = categoryOrder.map(c => ({
  key: c,
  meta: CATEGORIES[c],
  cases: useCases.filter(uc => uc.category === c),
}));
---
<UseCaseLayout
  title="InstaAccess Use Cases — Non-Human Identity on AWS"
  description="10 non-human identity scenarios on AWS — data exfiltration, lateral movement, privilege escalation, compliance, credential exposure — solved with preventive cloud controls."
  eyebrow="Use Cases"
  heroTitle="InstaAccess Use Cases"
  heroDescription="Non-human identities are the backbone of modern cloud operations — but they're also a silent and scalable risk. Here's how InstaAccess tackles the ten most common IAM risks we see."
  closingCtaTitle="Secure your non-human identities"
  closingCtaDescription="Book a demo to see InstaAccess against your AWS environment, or start free on the Marketplace."
>
  {grouped.map((group, gi) => (
    <div class={gi % 2 === 1 ? 'bg-slate-50' : ''}>
      <section class="mx-auto max-w-7xl px-6 py-20">
        <SectionHeader eyebrow={group.meta.eyebrow} title={group.meta.title} subtitle={group.meta.subtitle} />
        <div class="grid md:grid-cols-2 gap-6 mt-12">
          {group.cases.map(uc => (
            <article class="p-7 rounded-2xl bg-white border border-black/5 shadow-sm hover:shadow-md transition flex flex-col">
              <div class="flex gap-4 items-start">
                <IconBadge name={uc.icon} color={uc.iconColor} size="md" />
                <h3 class="font-bold text-[18px] text-[var(--color-text)] leading-tight tracking-tight flex-1 pt-1">{uc.title}</h3>
              </div>
              <p class="mt-4 text-[15px] text-slate-700 leading-relaxed"><span class="font-semibold text-[var(--color-accent)]">Risk:</span> {uc.risk}</p>
              <ul class="mt-4 space-y-2">
                {uc.solutions.map(s => (
                  <li class="flex gap-2.5 text-[14px] text-slate-800 leading-relaxed">
                    <span class="text-[var(--color-brand)] font-bold shrink-0">▸</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>
    </div>
  ))}

  <section class="mx-auto max-w-3xl px-6 py-12 text-center">
    <SectionHeader
      title="Ready to explore InstaAccess?"
      subtitle="Each use case above is a live capability in the platform. Book a demo or try it directly on AWS Marketplace."
    />
  </section>
</UseCaseLayout>
