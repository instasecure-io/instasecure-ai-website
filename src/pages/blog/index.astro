---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { AUTHORS } from '@/data/authors';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title="Blog | InstaSecure"
  description="Writing on preventive cloud security, AWS IAM, credential compromise, compliance, and the InstaSecure platform — from the team building the product."
>
  <Hero
    eyebrow="Blog"
    title="Fresh Thinking on Cloud Security"
    description="Product updates, threat research, AWS IAM deep-dives, and behind-the-scenes notes from the team building InstaSecure."
  />

  <section class="mx-auto max-w-6xl px-6 py-16">
    {posts.length === 0 ? (
      <p class="text-center text-slate-600">No posts yet — check back soon.</p>
    ) : (
      <>
        {/* Featured post — newest, full-width hero card */}
        {posts[0] && (() => {
          const p = posts[0];
          const author = AUTHORS[p.data.author];
          return (
            <a href={`/blog/${p.slug}`} class="group block rounded-2xl overflow-hidden bg-white border border-black/5 shadow-sm hover:shadow-lg transition mb-16">
              <div class="grid md:grid-cols-2 gap-0">
                {p.data.heroImage && (
                  <img src={p.data.heroImage.src} alt="" class="w-full h-full object-cover aspect-[16/10] md:aspect-auto" />
                )}
                <div class="p-8 md:p-10 flex flex-col justify-center">
                  <div class="text-xs uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-3">Featured</div>
                  <div class="flex flex-wrap gap-2 text-xs text-slate-600 font-semibold mb-3">
                    <time datetime={p.data.publishDate.toISOString()}>{dateFmt(p.data.publishDate)}</time>
                    {p.data.tags.length > 0 && <><span>·</span><span>{p.data.tags.slice(0, 2).join(' · ')}</span></>}
                  </div>
                  <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] leading-tight tracking-tight group-hover:text-[var(--color-brand)] transition">{p.data.title}</h2>
                  <p class="mt-4 text-slate-700 leading-relaxed">{p.data.description}</p>
                  <div class="mt-6 text-sm text-slate-600">
                    <span class="font-semibold text-[var(--color-text)]">{author?.name ?? p.data.author}</span>
                    {author?.title && <span class="text-slate-500"> · {author.title}</span>}
                  </div>
                </div>
              </div>
            </a>
          );
        })()}

        {posts.length > 1 && (
          <>
            <SectionHeader eyebrow="More Posts" title="Explore the rest" align="left" />
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
              {posts.slice(1).map(p => {
                const author = AUTHORS[p.data.author];
                return (
                  <a href={`/blog/${p.slug}`} class="group block rounded-2xl overflow-hidden bg-white border border-black/5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition flex flex-col">
                    {p.data.heroImage && (
                      <img src={p.data.heroImage.src} alt="" class="w-full aspect-[16/10] object-cover" />
                    )}
                    <div class="p-6 flex flex-col flex-1">
                      <div class="text-xs text-slate-600 font-semibold">
                        <time datetime={p.data.publishDate.toISOString()}>{dateFmt(p.data.publishDate)}</time>
                      </div>
                      <h3 class="mt-2 text-lg font-bold text-[var(--color-text)] leading-tight tracking-tight group-hover:text-[var(--color-brand)] transition flex-1">{p.data.title}</h3>
                      {p.data.tags.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {p.data.tags.slice(0, 3).map(t => <span class="text-[11px] font-bold tracking-[0.08em] uppercase text-[var(--color-brand)] bg-[var(--color-brand)]/10 rounded-full px-2 py-0.5">{t}</span>)}
                        </div>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          </>
        )}
      </>
    )}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'InstaSecure Blog',
    url: 'https://instasecure.ai/blog',
    publisher: { '@type': 'Organization', name: 'InstaSecure', url: 'https://instasecure.ai' },
    blogPost: posts.map(p => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      datePublished: p.data.publishDate.toISOString(),
      url: `https://instasecure.ai/blog/${p.slug}`,
    })),
  })} />
</BaseLayout>
