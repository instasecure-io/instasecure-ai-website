---
// src/pages/learn/guardrails-challenge.astro
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
// Aliased: this file name PascalCases to `GuardrailsChallenge`, which would
// collide with a same-named import (astro check ts2440).
import GuardrailsChallengeSection from '@/components/sections/GuardrailsChallenge.astro';
---
<BaseLayout
  title="Guardrails Challenge — Can you hold the wall against a live cloud intrusion? | InstaSecure"
  description="A timed run through a real cloud kill-chain on a representative sample of InstaSecure's 122 AWS preventive guardrails: each gate is a documented breach — pick the one guardrail (SCP / RCP / data-perimeter) that stops it. Streaks, ranks, a breach limit, and a shareable after-action report."
>
  <section class="relative overflow-hidden bg-gradient-to-br from-white via-[var(--color-brand)]/[0.04] to-[var(--color-accent)]/[0.05]">
    <div class="mx-auto max-w-4xl px-6 pt-20 pb-14 text-center">
      <div class="text-sm uppercase tracking-[0.15em] font-mono font-medium text-[var(--color-brand)] mb-4">Guardrails Challenge</div>
      <h1 class="font-serif text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight text-[var(--color-text)]">
        122 guardrails. How many stand between an attacker and your cloud?
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-slate-700 leading-relaxed">
        Every gate is a documented cloud breach; the four choices are real InstaSecure guardrails — SCPs, RCPs, and data-perimeter policies the AWS control plane enforces at runtime, not pre-deploy IaC checks — a representative sample of the 122. Now they're chained into one live intrusion: hold the wall, gate by gate.
      </p>
    </div>
  </section>

  <GuardrailsChallengeSection />
</BaseLayout>
