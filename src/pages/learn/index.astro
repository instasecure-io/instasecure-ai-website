---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import LearnCard from '@/components/learn/LearnCard.astro';
import { LEARN_CATEGORIES, LEARN_ITEMS } from '@/data/learn/catalog';
import { getCollection, type CollectionEntry } from 'astro:content';

const sectionCategories = LEARN_CATEGORIES.filter(c => c.id !== 'blog');
const blogCategory = LEARN_CATEGORIES.find(c => c.id === 'blog');

const posts = (await getCollection('blog'))
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID;
const newsletterAction = formspreeId ? `https://formspree.io/f/${formspreeId}` : '#';
---
<BaseLayout
  title="Learn — Games, Simulators & Field Guides on Cloud Security | InstaSecure"
  description="Interactive games, policy simulators, self-assessments, and field guides on cloud security architecture — SCPs, RCPs, data perimeter, and the patterns behind real cloud breaches."
>
  <section class="relative overflow-hidden bg-gradient-to-br from-white via-[var(--color-brand)]/[0.04] to-[var(--color-accent)]/[0.05]">
    <div class="mx-auto max-w-5xl px-6 pt-20 pb-16 text-center">
      <div class="text-sm uppercase tracking-[0.15em] font-mono font-medium text-[var(--color-brand)] mb-4">Learn</div>
      <h1 class="font-serif text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight text-[var(--color-text)]">
        Cloud security architecture,<br/>vendor-neutral.
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg md:text-xl text-slate-700 leading-relaxed">
        Games, simulators, self-assessments, and field guides on the architectural problems behind real cloud breaches — and the AWS-native primitives (SCPs, RCPs, data perimeter) that close them. No marketing. The actual techniques.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {LEARN_CATEGORIES.map(c => (
          <a href={c.href} class="px-4 py-2 rounded-full border border-black/10 bg-white/70 text-sm font-medium text-[var(--color-text)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition">
            {c.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {sectionCategories.map((cat, idx) => {
    const items = LEARN_ITEMS.filter(i => i.category === cat.id);
    return (
      <section id={cat.id} class={`scroll-mt-24 ${idx % 2 === 1 ? 'bg-slate-50 border-y border-black/5' : ''}`}>
        <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
          <h2 class="font-serif text-3xl md:text-4xl font-semibold leading-tight tracking-tight text-[var(--color-text)]">{cat.label}</h2>
          <p class="mt-3 text-base md:text-lg text-slate-600">{cat.description}</p>
          <div class="mt-10 grid gap-8">
            {items.map(item => (
              <LearnCard
                href={item.href}
                eyebrow={item.eyebrow}
                title={item.title}
                summary={item.summary}
                meta={item.readingTime}
                topics={item.topics}
                featured={item.featured}
                cta={item.cta}
              />
            ))}
          </div>
        </div>
      </section>
    );
  })}

  {blogCategory && posts.length > 0 && (
    <section class="scroll-mt-24">
      <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <div class="flex items-end justify-between gap-4 flex-wrap">
          <div>
            <h2 class="font-serif text-3xl md:text-4xl font-semibold leading-tight tracking-tight text-[var(--color-text)]">From the blog</h2>
            <p class="mt-3 text-base md:text-lg text-slate-600">{blogCategory.description}</p>
          </div>
          <a href="/blog" class="text-sm font-semibold text-[var(--color-brand)] hover:underline whitespace-nowrap">All posts →</a>
        </div>
        <div class="mt-10 grid md:grid-cols-3 gap-6">
          {posts.map((p: CollectionEntry<'blog'>) => (
            <LearnCard
              compact
              href={`/blog/${p.slug}`}
              eyebrow="Blog"
              title={p.data.title}
              summary={p.data.description}
              meta={dateFmt(p.data.publishDate)}
              metaDatetime={p.data.publishDate.toISOString()}
              topics={p.data.tags.slice(0, 3)}
              cta="Read the post →"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Subscribe — RSS + email -->
  <section class="bg-slate-50 border-t border-black/5">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <div class="text-sm uppercase tracking-[0.15em] font-mono font-medium text-[var(--color-brand)] mb-3 text-center">Stay in the loop</div>
      <h2 class="text-center font-serif text-2xl md:text-3xl font-semibold leading-tight tracking-tight text-[var(--color-text)]">Get new field guides when they ship.</h2>
      <p class="mt-3 text-center text-base text-slate-600 max-w-xl mx-auto">No marketing. Just deeply technical writing on cloud security architecture, AWS IAM, and the patterns behind real breaches.</p>

      <form
        action={newsletterAction}
        method="POST"
        class="mt-8 flex flex-col sm:flex-row gap-3 max-w-xl mx-auto"
      >
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder="you@company.com"
          class="flex-1 rounded-lg border border-black/10 bg-white px-4 py-3 text-[15px] outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/20 transition"
        />
        <input type="hidden" name="_subject" value="Learn newsletter signup" />
        <input type="hidden" name="source" value="learn-index" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 bg-[var(--color-accent)] text-white font-semibold hover:opacity-90 shadow-md shadow-[var(--color-accent)]/25 transition text-base whitespace-nowrap"
        >
          Subscribe →
        </button>
      </form>

      <div class="mt-6 flex items-center justify-center gap-3 text-sm text-slate-500">
        <span>Prefer a feed reader?</span>
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-2 font-mono uppercase tracking-[0.1em] text-xs text-[var(--color-brand)] hover:underline"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A19.56 19.56 0 0 1 23.56 24h-2.83A16.73 16.73 0 0 0 4 7.27V4.44zm0 5.66A13.9 13.9 0 0 1 17.9 24h-2.83A11.07 11.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          Subscribe via RSS
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
