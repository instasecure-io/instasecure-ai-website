  <!-- Asciinema player init — runs on first load AND after Astro view transitions -->
  <script is:inline>
    (function () {
      function initCast() {
        const host = document.getElementById('cast-player');
        if (!host || host.dataset.castInit === '1') return;
        if (!window.AsciinemaPlayer) { setTimeout(initCast, 100); return; }
        host.dataset.castInit = '1';
        window.AsciinemaPlayer.create('/learn/demo-llm-privesc.cast', host, {
          autoPlay: false,
          preload: true,
          fit: 'width',
          speed: 0.7,
          theme: 'asciinema',
          terminalFontSize: '0.95em',
          terminalLineHeight: 1.35,
          poster: 'npt:0:1',
          idleTimeLimit: 0.8,
        });
        // Patch a11y: the vendored asciinema player exposes the timer as
        // role="textbox" but without an accessible name. Lighthouse flags it.
        // Add the label once the DOM nodes exist; retry briefly while the player mounts.
        let tries = 0;
        const labelTimer = () => {
          const t = host.querySelector('.ap-timer');
          if (t && !t.getAttribute('aria-label')) {
            t.setAttribute('aria-label', 'Playback time');
          }
          if (++tries < 20 && (!t || !t.getAttribute('aria-label'))) setTimeout(labelTimer, 100);
        };
        labelTimer();
      }
      // Fires on initial load and on every Astro view transition
      document.addEventListener('astro:page-load', initCast);
      // Belt-and-suspenders: also run immediately if the DOM is already parsed
      if (document.readyState !== 'loading') initCast();
      else document.addEventListener('DOMContentLoaded', initCast);
    })();
  </script>
