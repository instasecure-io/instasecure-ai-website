---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import CTAStripe from '@/components/sections/CTAStripe.astro';
import IconBadge from '@/components/ui/IconBadge.astro';

const AWS_MARKETPLACE = 'https://aws.amazon.com/marketplace/pp/prodview-kmlldyula7axs?sr=0-1&ref_=beagle&applicationId=AWSMPContessa';
const CALENDLY = import.meta.env.PUBLIC_CALENDLY_DEMO_URL;
const LINKEDIN = 'https://www.linkedin.com/company/instasecure/';

const newsItems = [
  {
    title: 'InstaSecure and Prowler Form Strategic Partnership to Set a New Standard in Cloud Security',
    date: '2025-04-15',
    dateLabel: 'April 15, 2025',
    source: 'PRWeb',
    href: 'https://www.prweb.com/releases/instasecure-and-prowler-form-strategic-partnership-to-set-a-new-standard-in-cloud-security-302428384.html',
    description: 'InstaSecure and Prowler announce a strategic partnership combining open-source cloud security assessment with InstaSecure\'s preventive cloud controls — giving security teams a tighter loop from detection to enforcement.',
  },
];
---
<BaseLayout
  title="News — InstaSecure Cloud Security"
  description="The latest news, media coverage, partnerships, and awards from InstaSecure — preventive AWS cloud security. Press releases and company announcements."
>
  <Hero
    eyebrow="News"
    title="The Newsroom"
    description="The latest news, media coverage, and awards from InstaSecure. For press inquiries, reach us on the contact page."
  />

  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="mb-10">
      <SectionHeader eyebrow="Recent" title="Press & announcements" align="left" />
    </div>

    <div class="space-y-6">
      {newsItems.map(item => (
        <article class="p-8 rounded-2xl bg-white border border-black/5 shadow-sm hover:shadow-md transition">
          <div class="flex gap-5 items-start">
            <IconBadge name="lucide:newspaper" color="brand" size="md" />
            <div class="flex-1">
              <div class="flex flex-wrap gap-3 items-center text-xs font-bold text-slate-500 tracking-[0.1em] uppercase">
                <time datetime={item.date}>{item.dateLabel}</time>
                <span>·</span>
                <span class="text-[var(--color-brand)]">{item.source}</span>
              </div>
              <h2 class="text-xl md:text-2xl font-bold text-[var(--color-text)] mt-2 leading-tight tracking-tight">
                <a href={item.href} target="_blank" rel="noopener" class="hover:text-[var(--color-brand)] transition">{item.title}</a>
              </h2>
              <p class="mt-3 text-[16px] text-slate-700 leading-relaxed">{item.description}</p>
              <a href={item.href} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-brand)] hover:underline">
                Read full release →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 p-10 rounded-2xl bg-slate-50 border border-black/5 text-center">
      <div class="text-sm uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-3">Stay Updated</div>
      <h3 class="text-2xl font-bold text-[var(--color-text)] tracking-tight">Follow InstaSecure on LinkedIn</h3>
      <p class="mt-3 text-slate-700 max-w-lg mx-auto">Product updates, partnership news, and threat research — the moment we publish it.</p>
      <a href={LINKEDIN} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 rounded-full px-6 py-3 bg-[var(--color-brand)] text-white font-semibold hover:opacity-90 transition text-sm">
        Follow on LinkedIn →
      </a>
    </div>
  </section>

  <CTAStripe
    title="Want to cover InstaSecure?"
    description="For press inquiries, demos, or analyst briefings — get in touch."
    supporting="Choose your path — media request, demo, or start free on AWS Marketplace."
    primaryCta={{ label: 'Contact', href: '/contact' }}
    secondaryCta={{ label: 'Start Free Trial', href: AWS_MARKETPLACE }}
  />
</BaseLayout>
