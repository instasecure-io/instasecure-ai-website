---
import UseCaseLayout from '@/layouts/UseCaseLayout.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';

type Category = 'defend' | 'blast-radius' | 'govern';

interface UseCase {
  category: Category;
  icon: string;
  iconColor: 'brand' | 'accent';
  title: string;
  risk: string;
  solutions: string[];
}

const CATEGORIES: Record<Category, { eyebrow: string; title: string; subtitle: string }> = {
  defend: {
    eyebrow: 'Defend Against Attacks',
    title: 'Stop active cloud threats',
    subtitle: 'Block credential compromise, privilege escalation, lateral movement, and crypto-mining abuse — before they impact the business.',
  },
  'blast-radius': {
    eyebrow: 'Reduce Blast Radius',
    title: 'Contain compromise and shrink exposure',
    subtitle: 'Keep excessive human access from turning into cross-account pivot or broad data exposure when accounts are compromised.',
  },
  govern: {
    eyebrow: 'Govern & Comply',
    title: 'Audit-ready human-access governance',
    subtitle: 'Access reviews, compliance evidence, and separation of duties — automated so you spend hours, not weeks.',
  },
};

const useCases: UseCase[] = [
  {
    category: 'defend',
    icon: 'lucide:download',
    iconColor: 'accent',
    title: 'Data Exfiltration Prevention',
    risk: 'Over-permissioned human identities may access and export sensitive data from services like S3 or RDS — intentionally or after compromise.',
    solutions: [
      'Identify human identities with direct access to sensitive data stores',
      'Flag unused or excessive permissions (e.g., wildcard S3 permissions)',
      'Automate permission right-sizing to enforce least privilege',
      'Integrate with KMS key policies so only approved identities can decrypt data',
    ],
  },
  {
    category: 'defend',
    icon: 'lucide:key',
    iconColor: 'brand',
    title: 'Credential Compromise',
    risk: 'Stolen or leaked IAM credentials can be used to access critical AWS services.',
    solutions: [
      'Detect long-lived IAM users and encourage short-lived session-based access',
      'Highlight dormant users or credentials for deactivation',
      'Enforce MFA via Identity Center integration',
      'Support policy conditions like IP or device-based restrictions',
    ],
  },
  {
    category: 'defend',
    icon: 'lucide:arrow-up-right',
    iconColor: 'accent',
    title: 'Privilege Escalation Prevention',
    risk: 'Misconfigured roles or policies allow users to grant themselves or others elevated access.',
    solutions: [
      'Detect toxic combinations (e.g., iam:CreateRole + iam:AttachPolicy)',
      'Recommend permissions boundaries and SCPs to close escalation paths',
      'Provide alerts and remediation for privilege anomalies',
    ],
  },
  {
    category: 'defend',
    icon: 'lucide:git-branch',
    iconColor: 'brand',
    title: 'Lateral Movement Risk',
    risk: 'Compromised users with cross-account trust or broad IAM privileges may pivot into other environments.',
    solutions: [
      'Visualize cross-account role assumptions and access paths',
      'Detect overly permissive trust relationships',
      'Recommend and enforce tighter trust policies',
      'Support SCPs to restrict role assumption across accounts',
    ],
  },
  {
    category: 'defend',
    icon: 'lucide:cpu',
    iconColor: 'accent',
    title: 'Crypto Mining Detection & Mitigation',
    risk: 'Attackers exploit compromised identities to launch unauthorized EC2 or container workloads for cryptocurrency mining.',
    solutions: [
      'Detect permission sets with EC2:RunInstances or EKS:RunPod',
      'Flag suspicious usage patterns via CloudTrail analysis',
      'Suggest SCPs to restrict service usage in non-prod or sensitive accounts',
    ],
  },
  {
    category: 'blast-radius',
    icon: 'lucide:minimize-2',
    iconColor: 'brand',
    title: 'Attack Surface Reduction',
    risk: 'Broad or excessive permissions increase the likelihood of accidental or malicious misuse.',
    solutions: [
      'Surface least-used permissions for review',
      'Enable periodic right-sizing based on CloudTrail activity',
      'Reduce high-risk permissions like admin access unless justified',
    ],
  },
  {
    category: 'blast-radius',
    icon: 'lucide:shield',
    iconColor: 'accent',
    title: 'Blast Radius Containment',
    risk: 'A compromised identity has excessive reach, impacting multiple services or accounts.',
    solutions: [
      'Restrict roles to specific accounts or services',
      'Limit access scope using IAM conditions and SCPs',
      'Support organization-wide policies for safe defaults',
    ],
  },
  {
    category: 'govern',
    icon: 'lucide:sparkles',
    iconColor: 'brand',
    title: 'Governance & Policy Hygiene for Human Access',
    risk: 'Inconsistent or outdated access policies lead to audit failures and security drift.',
    solutions: [
      'Enable automated access reviews and evidence collection',
      'Provide access visibility across AWS accounts and identity providers',
      'Enforce naming and tagging standards for IAM roles and users',
    ],
  },
  {
    category: 'govern',
    icon: 'lucide:file-check',
    iconColor: 'accent',
    title: 'Compliance Framework Alignment',
    risk: 'Failure to meet access governance requirements for frameworks like SOC 2, ISO 27001, or HIPAA.',
    solutions: [
      'Map controls to compliance standards (least privilege, MFA, access reviews)',
      'Automate evidence generation and export',
      'Enforce preventive controls aligned with compliance requirements',
    ],
  },
  {
    category: 'govern',
    icon: 'lucide:split',
    iconColor: 'brand',
    title: 'Segregation of Duties',
    risk: 'A single user holds permissions that should be split across multiple roles for control and oversight.',
    solutions: [
      'Detect roles with conflicting responsibilities (e.g., deploy + approve)',
      'Recommend role decomposition',
      'Enforce separation via permission design and cross-role limitations',
    ],
  },
];

const categoryOrder: Category[] = ['defend', 'blast-radius', 'govern'];
const grouped = categoryOrder.map(c => ({
  key: c,
  meta: CATEGORIES[c],
  cases: useCases.filter(uc => uc.category === c),
}));
---
<UseCaseLayout
  title="InstaWorkforce Use Cases — Human Access IAM on AWS"
  description="10 human-access scenarios on AWS — credential compromise, privilege escalation, lateral movement, compliance, blast-radius containment — solved with preventive IAM controls."
  eyebrow="Use Cases"
  heroTitle="InstaWorkforce Use Cases"
  heroDescription="Proactively govern human access in AWS and reduce cloud identity risks. Here's how InstaWorkforce tackles the ten most common workforce-IAM risks we see."
  closingCtaTitle="Govern your workforce access"
  closingCtaDescription="Book a demo to see InstaWorkforce map your actual access paths, or start free on the Marketplace."
>
  {grouped.map((group, gi) => (
    <div class={gi % 2 === 1 ? 'bg-slate-50' : ''}>
      <section class="mx-auto max-w-7xl px-6 py-20">
        <SectionHeader eyebrow={group.meta.eyebrow} title={group.meta.title} subtitle={group.meta.subtitle} />
        <div class="grid md:grid-cols-2 gap-6 mt-12">
          {group.cases.map(uc => (
            <article class="p-7 rounded-2xl bg-white border border-black/5 shadow-sm hover:shadow-md transition flex flex-col">
              <div class="flex gap-4 items-start">
                <IconBadge name={uc.icon} color={uc.iconColor} size="md" />
                <h3 class="font-bold text-[18px] text-[var(--color-text)] leading-tight tracking-tight flex-1 pt-1">{uc.title}</h3>
              </div>
              <p class="mt-4 text-[15px] text-slate-700 leading-relaxed"><span class="font-semibold text-[var(--color-accent)]">Risk:</span> {uc.risk}</p>
              <ul class="mt-4 space-y-2">
                {uc.solutions.map(s => (
                  <li class="flex gap-2.5 text-[14px] text-slate-800 leading-relaxed">
                    <span class="text-[var(--color-brand)] font-bold shrink-0">▸</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>
    </div>
  ))}

  <section class="mx-auto max-w-3xl px-6 py-12 text-center">
    <SectionHeader
      title="Ready to explore InstaWorkforce?"
      subtitle="Each use case above is a live capability. Book a demo or try it directly on AWS Marketplace."
    />
  </section>
</UseCaseLayout>
