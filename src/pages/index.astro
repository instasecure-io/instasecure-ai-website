---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import FeatureGrid from '@/components/sections/FeatureGrid.astro';
import StatsRow from '@/components/sections/StatsRow.astro';
import ProductTeaser from '@/components/sections/ProductTeaser.astro';
import TestimonialRow from '@/components/sections/TestimonialRow.astro';
import TrustBadges from '@/components/sections/TrustBadges.astro';
import ComparisonTable from '@/components/sections/ComparisonTable.astro';
import CTAStripe from '@/components/sections/CTAStripe.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';

import awsMarketplaceBadge from '@/assets/badges/aws-marketplace.png';
import awsPartnerBadge from '@/assets/badges/aws-partner.png';
import awsQualifiedBadge from '@/assets/badges/aws-qualified.png';
import platformDiagram from '@/assets/home/platform-diagram.png';
import productivityImg from '@/assets/home/productivity.png';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3)
  .map(p => ({
    date: p.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
    title: p.data.title,
    href: `/blog/${p.slug}`,
  }));

const AWS_MARKETPLACE = 'https://aws.amazon.com/marketplace/pp/prodview-kmlldyula7axs?sr=0-1&ref_=beagle&applicationId=AWSMPContessa';

const threeFeatures = [
  { icon: 'lucide:shield-check', iconColor: 'brand' as const, title: '50+ AWS-native preventive guardrails for AI, data & identity', description: 'Prevents misconfigurations across your entire environment from the moment they are deployed.' },
  { icon: 'lucide:zap', iconColor: 'accent' as const, title: 'Minutes to remediate risks — no code changes', description: 'Give your developers time back. Your team can now fix risks without manual intervention or complex coding.' },
  { icon: 'lucide:plug-zap', iconColor: 'brand' as const, title: 'Works with your CNAPP, IdP, and IaC', description: 'Our platform seamlessly integrates with your existing security and development tools, so you can get up and running instantly.' },
];

const outcomes = [
  {
    icon: 'lucide:sparkles',
    iconColor: 'accent' as const,
    title: 'Hygiene & AWS Governance',
    description: 'Ensure preventive enterprise-wide security baselines and governance control:',
    bullets: [
      'Protect AI services like Bedrock, Sagemaker, Amazon Polly, Rekognition',
      'Deny changes to security services',
      'Protect cloud platform resources',
      'Quarantine inactive users and service roles',
    ],
  },
  {
    icon: 'lucide:shield-alert',
    iconColor: 'brand' as const,
    title: 'Neutralize Ransomware & Insider Threats',
    description: 'Lock sensitive IAM permissions to shield against critical threats, including:',
    bullets: ['Ransomware', 'Privilege escalation', 'Data exfiltration', 'Infrastructure modification', 'Crypto-mining'],
  },
  {
    icon: 'lucide:package-check',
    iconColor: 'accent' as const,
    title: 'Build air-gapped environments',
    description: 'Build missing AWS Data Perimeters (IAM Trust Boundary) to prevent:',
    bullets: ['Credential theft', 'Zero-day exploits', 'Untrusted third-party access', 'Lateral movement', 'Data exfiltration'],
  },
];

const innovations = [
  {
    icon: 'lucide:lock-keyhole',
    iconColor: 'brand' as const,
    title: 'Cloud Hardening using Guardrails',
    description: '50+ AWS-specific preventive guardrails to enforce cloud hygiene by default — locking down misconfigured access to AI models, data, and pipelines, and shrinking attack surface from insider threats, architectural gaps, and advanced vectors.',
  },
  {
    icon: 'lucide:zap',
    iconColor: 'accent' as const,
    title: 'Real-Time Remediation using Preventive Virtual Patches',
    description: 'Policy-based virtual patches use historical behavior and risk insights to fix identity risks, misconfigs, and CNAPP findings in real time — minutes, not days — with no workload impact or developers required.',
  },
];

const differentiators = [
  { icon: 'lucide:shield-check', iconColor: 'brand' as const, title: 'Proactive Zero-Trust Security', description: 'InstaSecure leads with a zero-trust approach, eliminating threats before they can impact your organization.' },
  { icon: 'lucide:bell-ring', iconColor: 'accent' as const, title: 'Automated Alert Remediation', description: 'Unique automated grouping and remediation of CNAPP alerts ensures efficiency and reduces security team workload.' },
  { icon: 'lucide:building-2', iconColor: 'brand' as const, title: 'Organization-Wide Impact', description: 'Implement comprehensive protection across your entire infrastructure instead of incremental, asset-level responses.' },
  { icon: 'lucide:rocket', iconColor: 'accent' as const, title: 'Simplified Implementation', description: 'Get up and running in hours, not weeks or months, with intuitive onboarding and seamless integration.' },
];

const howDifferent = [
  'Instant Security Wins — fully deployable remediation, no dev dependency',
  'Preventive-first: shift from reactive fixes to enforced guardrails',
  'No-code: no changes to pipelines or IaC to get value',
  'Broad coverage: resolve groups of related alerts at once',
  'Human identity governance: visibility + cleanup',
];

const teamStats = [
  { value: '82%', label: 'Of alerts resolved instantly', description: 'Preventive cloud controls solve entire classes of alerts at once — no more fixing them one by one.' },
  { value: '$3M', label: 'Cost savings over two years', description: 'Thanks to the efficiency gains of InstaSecure.' },
  { value: '10×', label: 'Your cloud security team', description: 'Unlock their time to focus on data loss, credential compromise, and compliance mandates.' },
];

const products = [
  {
    name: 'InstaAccess',
    tagline: 'Cloud Configuration Hardening & Automated Remediation',
    description: 'Protect non-human identities — service roles, automation agents, third-party integrations. InstaAccess automates the hardening of cloud configurations, prevents untrusted access, and remediates exposure risks in minutes — without disrupting workloads.',
    primaryCta: { label: 'Learn more', href: '/instaaccess' },
    secondaryCta: { label: 'View InstaAccess Use Cases', href: '/instaaccess-use-cases' },
  },
  {
    name: 'InstaWorkforce',
    tagline: 'Secure Human Access to the Cloud',
    description: 'Ensure least-privilege, just-in-time, and policy-aligned access for your workforce across cloud environments. InstaWorkforce enforces identity-based segmentation, detects privilege creep, and helps eliminate excessive access risks for employees, contractors, and partners.',
    primaryCta: { label: 'Learn more', href: '/instaworkforce' },
    secondaryCta: { label: 'View InstaWorkforce Use Cases', href: '/instaworkforce-use-cases' },
  },
];

const testimonials = [
  {
    quote: 'As a cloud security practitioner, an SSRF attack or data exfiltration keeps me up at night. I am thankful to see industry partners like InstaSecure working to help us sleep better.',
    name: 'Houston Hopkins',
    title: 'Sr Security Manager of Cloud Security',
  },
  {
    quote: 'InstaSecure helps customers deploy proactive to defeat attacks using compromised credentials, misconfigurations and zero-day vulnerabilities. I see this as a key preventative control for cloud security.',
    name: 'Tyler Pinckard',
    title: 'Data Protection Officer & Sr Manager of Engineering for DevOps & Security',
    company: 'SupportLogic',
  },
];

const trustBadgesResolved = [
  { src: awsMarketplaceBadge.src, alt: 'Available in AWS Marketplace', href: 'https://aws.amazon.com/marketplace/seller-profile?id=4a6c459c-f656-480a-812c-eab216c22824', height: 56 },
  { src: awsPartnerBadge.src, alt: 'AWS Partner', height: 64 },
  { src: awsQualifiedBadge.src, alt: 'AWS Certified Qualified Software', height: 64 },
];

const comparisonColumns = ['InstaSecure', 'In-House', 'Cloud Providers', 'CSPM / CIEM / DSPM'];
const comparisonRows = [
  { feature: 'Automated Remediation', values: [true, false, false, false] },
  { feature: 'Preventive Approach', values: [true, false, false, false] },
  { feature: 'Alert Grouping & Prioritization', values: [true, false, 'partial', 'partial'] },
  { feature: 'Always Current', values: [true, false, true, true] },
  { feature: 'Multi-Cloud Support', values: [true, false, false, true] },
  { feature: 'Implementation Time', values: ['Hours', 'Months', 'Weeks', 'Weeks'] },
  { feature: 'Time to Value', values: ['Immediate', 'Months', 'Weeks', 'Weeks'] },
];

---
<BaseLayout
  title="InstaSecure — Proactive Cloud Security for AWS"
  description="Built for AWS, InstaSecure enforces enterprise-wide baselines, stops misconfigurations, and prevents privilege creep — with zero friction and zero code changes."
>
  <Hero
    eyebrow="Proactive Cloud Security"
    title="Zero Noise — All Fixes."
    description="Built for AWS, InstaSecure enables DevSecOps, platform, and cloud security teams to enforce enterprise-wide baselines, stop misconfigurations, and prevent privilege creep — hardening your cloud with stronger security, faster compliance, and cost savings, with zero friction and zero code changes."
    primaryCta={{ label: 'Start Free Trial', href: AWS_MARKETPLACE }}
    secondaryCta={{ label: 'Book a Demo', href: '/contact' }}
    image={{
      src: 'https://images.squarespace-cdn.com/content/v1/66272c93ced316215a563dca/b53da488-6aa2-4cc4-8c54-888753fa8d9c/home-rotate1.2.gif',
      alt: 'Proactive Threat Reduction — enforcement of security baselines and closing architectural gaps reduces risk from ransomware and crypto-mining.',
    }}
  />

  <TrustBadges title="AWS-Native Cloud Security" badges={trustBadgesResolved} />

  <FeatureGrid
    eyebrow="Real-Time Remediation"
    title="Virtual Patches, Instantly"
    features={threeFeatures}
    columns={3}
  />

  <div class="bg-slate-50">
    <FeatureGrid
      eyebrow="Outcomes"
      title="Security Outcomes You Can Achieve Fast"
      features={outcomes}
      columns={3}
    />
  </div>

  <FeatureGrid
    eyebrow="Two Key Innovations"
    title="InstaSecure Delivers"
    features={innovations}
    columns={2}
  />

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="text-sm uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-4">The InstaSecure Platform</div>
      <h2 class="text-3xl md:text-5xl font-bold leading-[1.1] tracking-tight text-[var(--color-text)]">The Cloud Identity Firewall Platform</h2>
      <p class="mt-5 text-lg md:text-xl text-slate-700 leading-relaxed">Preventive cloud controls that rapidly remediate alerts within minutes and automatically prevent future risk of the same type.</p>
    </div>
    <img src={platformDiagram.src} alt="InstaSecure platform architecture showing preventive guardrails layered across AWS services" class="w-full max-w-5xl mx-auto" />
  </section>

  <StatsRow
    title="Enhance Your Cloud Security Team"
    subtitle="Empower your central security team to own the entire process."
    stats={teamStats}
    image={{ src: productivityImg.src, alt: 'Productivity gains for cloud security teams using InstaSecure' }}
  />

  <FeatureGrid
    eyebrow="Why We Stand Out"
    title="Why InstaSecure Stands Out"
    features={differentiators}
    columns={4}
  />

  <div class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-6 py-20">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <div class="text-sm uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-4">How We're Different</div>
        <h2 class="text-3xl md:text-5xl font-bold leading-[1.1] tracking-tight text-[var(--color-text)]">Preventive. Automated. Enterprise-wide.</h2>
      </div>
      <ul class="max-w-3xl mx-auto space-y-4">
        {howDifferent.map(point => (
          <li class="flex gap-4 items-start p-6 bg-white rounded-xl border border-black/5 shadow-sm">
            <span class="text-[var(--color-accent)] text-2xl font-bold leading-none shrink-0">✓</span>
            <span class="text-lg text-slate-800 leading-relaxed">{point}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <ProductTeaser
    eyebrow="Our Products"
    title="Comprehensive Protection for Human and Non-Human Access"
    products={products}
  />

  <ComparisonTable
    eyebrow="How We Compare"
    title="See Where InstaSecure Stands Apart"
    subtitle="Side-by-side with in-house efforts, native cloud tools, and legacy security vendors."
    columns={comparisonColumns}
    rows={comparisonRows}
    highlightColumn={0}
  />

  <TestimonialRow testimonials={testimonials} />

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="mb-12">
      <SectionHeader eyebrow="Latest from our Blog" title="Fresh Thinking on Cloud Security" />
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {latestPosts.map(post => (
        <a href={post.href} class="group p-6 rounded-2xl border border-black/5 bg-white hover:shadow-lg hover:-translate-y-0.5 transition">
          <div class="text-sm text-slate-600 font-semibold">{post.date}</div>
          <h3 class="mt-3 text-lg font-bold text-[var(--color-text)] leading-snug group-hover:text-[var(--color-brand)] transition">{post.title}</h3>
          <div class="mt-5 text-sm font-bold text-[var(--color-brand)]">Read post →</div>
        </a>
      ))}
    </div>
  </section>

  <CTAStripe
    title="Ready to Build a Safer Cloud?"
    description="Cloud teams like yours are already seeing results in weeks. You could be next."
    supporting="Choose your path — self-serve on AWS Marketplace or schedule a personalized walkthrough."
    primaryCta={{ label: 'Start Free Trial', href: AWS_MARKETPLACE }}
    secondaryCta={{ label: 'Get a Demo', href: '/contact' }}
  />
</BaseLayout>
