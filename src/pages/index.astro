---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Hero from '@/components/sections/Hero.astro';
import FeatureGrid from '@/components/sections/FeatureGrid.astro';
import StepFlow from '@/components/sections/StepFlow.astro';
import VersusBlock from '@/components/sections/VersusBlock.astro';
import PhasesSection from '@/components/sections/PhasesSection.astro';
import TestimonialRow from '@/components/sections/TestimonialRow.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import CTAStripe from '@/components/sections/CTAStripe.astro';
import HeroAttackTerminal from '@/components/sections/HeroAttackTerminal.astro';
import TuesdayAttackScene from '@/components/sections/TuesdayAttackScene.astro';
import { getCollection } from 'astro:content';
import awsMarketplaceBadge from '@/assets/badges/aws-marketplace.png';
import awsPartnerBadge from '@/assets/badges/aws-partner.png';
import awsQualifiedBadge from '@/assets/badges/aws-qualified.png';

const AWS_MARKETPLACE = 'https://aws.amazon.com/marketplace/pp/prodview-kmlldyula7axs?sr=0-1&ref_=beagle&applicationId=AWSMPContessa';

const trustBadgesResolved = [
  { src: awsMarketplaceBadge.src, alt: 'Available in AWS Marketplace', href: 'https://aws.amazon.com/marketplace/seller-profile?id=4a6c459c-f656-480a-812c-eab216c22824', height: 56, intrinsicWidth: awsMarketplaceBadge.width, intrinsicHeight: awsMarketplaceBadge.height },
  { src: awsPartnerBadge.src, alt: 'AWS Partner', height: 64, intrinsicWidth: awsPartnerBadge.width, intrinsicHeight: awsPartnerBadge.height },
  { src: awsQualifiedBadge.src, alt: 'AWS Certified Qualified Software', height: 64, intrinsicWidth: awsQualifiedBadge.width, intrinsicHeight: awsQualifiedBadge.height },
];

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3)
  .map(p => ({
    date: p.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
    title: p.data.title,
    href: `/blog/${p.slug}`,
  }));

const testimonials = [
  {
    quote: 'As a cloud security practitioner, an SSRF attack or data exfiltration keeps me up at night. I am thankful to see industry partners like InstaSecure working to help us sleep better.',
    name: 'Houston Hopkins',
    title: 'Sr Security Manager of Cloud Security',
  },
  {
    quote: 'InstaSecure helps customers deploy proactive to defeat attacks using compromised credentials, misconfigurations and zero-day vulnerabilities. I see this as a key preventative control for cloud security.',
    name: 'Tyler Pinckard',
    title: 'Data Protection Officer & Sr Manager of Engineering for DevOps & Security',
    company: 'SupportLogic',
  },
];

const threats = [
  {
    icon: 'lucide:bot',
    iconColor: 'brand' as const,
    title: 'Attackers automated.',
    description: 'Frontier models enumerate IAM paths, trust chains, and misconfigurations in minutes. The cloud attack surface moved from payload to policy — and policy is where AI-assisted attackers now live.',
  },
  {
    icon: 'lucide:key-round',
    iconColor: 'accent' as const,
    title: 'Defenders drowned.',
    description: 'Non-human identities — service roles, pipelines, third-parties, AI agents — already outnumber humans 20–50 to 1. Every new agent is a new credential. SOC alert volume rises faster than headcount ever can.',
  },
  {
    icon: 'lucide:clock-alert',
    iconColor: 'brand' as const,
    title: "Detection lost its economics.",
    description: 'Finding threats faster than attackers move is a losing race against AI-accelerated adversaries. Mean-time-to-detect becomes meaningless when mean-time-to-compromise collapses to minutes.',
  },
];

const gatesVsGuardrails = {
  before: {
    label: 'Gates',
    image: {
      src: '/home/gates.svg',
      alt: 'A pipeline gate is a single wall segment between PR build steps and AWS prod. The attacker walks around it via a stolen credential — the wall has no top and no sides.',
      width: 440,
      height: 270,
    },
    bullets: [
      'CI/CD scanners, IaC linters, PR blockers at deploy time',
      'Slow developers to catch attackers who don\'t use your pipeline',
      'Cover greenfield code only — legacy and runtime drift stay exposed',
      'Every fix is a ticket and a developer hour',
    ],
  },
  after: {
    label: 'Guardrails',
    image: {
      src: '/home/guardrails.svg',
      alt: 'The same wall material wraps the entire AWS Organization — prod, stage, dev, data, security, audit, network and future accounts. The attacker hits the perimeter (SCP, RCP, org policy) and is denied regardless of how they arrived.',
      width: 500,
      height: 270,
    },
    bullets: [
      'Policy enforced at the organization edge, above every account',
      'Invisible to developers — zero pipeline friction, zero PR gates',
      'Cover every account, every resource, every future deployment',
      'One guardrail retires a whole class of findings, permanently',
    ],
  },
};

const steps = [
  { icon: 'lucide:search', title: 'Discover', description: 'Map every identity — human, service, pipeline, agent — and the actions each one can actually take across your AWS org.' },
  { icon: 'lucide:workflow', title: 'Prioritize', description: 'Build the attack graph. Calculate blast radius per identity. Rank the exposures that matter before attackers rank them.' },
  { icon: 'lucide:shield-check', title: 'Enforce', description: 'Deploy the guardrail set. Policy installs at the organization edge — no pipeline changes, no developer tickets, no code.' },
  { icon: 'lucide:plus-circle', title: 'Extend', description: 'Your guardrails library grows with attacker capability. New attack class → new guardrail → org-wide, continuously.' },
];

const economicsBefore = {
  label: 'CSPM + SOC',
  bullets: [
    'Linear headcount growth to scale detection — every new alert source needs analysts',
    'Sub-linear coverage — tomorrow\'s attack isn\'t in yesterday\'s rules',
    'Attacker-tempo dependent — loses to AI-speed adversaries by design',
  ],
};
const economicsAfter = {
  label: 'InstaSecure guardrails',
  bullets: [
    'Fixed-cost boundary — one enforcement layer, organization-wide, forever',
    'Deterministic coverage — impossibility is impossibility at any attacker speed',
    'Attacker-tempo independent — prevention doesn\'t race, it pre-commits',
  ],
};
---
<BaseLayout
  title="Preventive AWS Cloud Security Controls | InstaSecure"
  description="Preventive AWS cloud security controls — SCPs, RCPs, and data perimeters block credential compromise and AI-driven attacks before they happen. Org-wide. Zero code."
>
  <Hero
    eyebrow="Agentic Cloud Security · Preventive Guardrails"
    title="Attackers got AI. Your defense needs"
    titleHighlight="automation."
    description="InstaSecure is the Guardrails platform for AWS — automated, organization-wide policy that makes whole classes of attack structurally impossible. Stolen credentials go inert. Rogue agents hit a wall. Privilege drift loses its blast radius. Zero code. Minutes to enforced."
    primaryCta={{ label: 'Start Free Trial', href: AWS_MARKETPLACE }}
    secondaryCta={{ label: 'Find your guardrails phase', href: '/contact' }}
    trustLine="Available on AWS Marketplace · No credit card · Bills via your AWS account"
  >
    <HeroAttackTerminal />
  </Hero>

  <TuesdayAttackScene />

  <FeatureGrid
    eyebrow="The shift"
    title="The attack economy flipped. The defense stack didn't."
    subtitle="Three things changed in 24 months. Most security programs were built for the world that existed before them."
    features={threats}
    columns={3}
  />

  <div class="bg-slate-50">
    <VersusBlock
      eyebrow="The choice"
      title="Two ways to stop a misconfiguration. Only one stops an attacker."
      subtitle="The industry moved from scanning to preventing — because there's no other way to keep up with AI-speed attackers."
      before={gatesVsGuardrails.before}
      after={gatesVsGuardrails.after}
    />
  </div>

  <PhasesSection defaultActive={3} defaultMaturity={1} showMaturity={true} />

  <div class="bg-slate-50">
    <StepFlow
      eyebrow="How it works"
      title="Zero code. Org-wide. Minutes to enforced."
      subtitle="No pipeline changes. No developer tickets. Just policy, installed at the control plane."
      steps={steps}
    />
  </div>

  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="text-center max-w-3xl mx-auto">
      <div class="text-sm uppercase tracking-[0.15em] font-mono font-medium text-[var(--color-brand)] mb-4">Coexists with your stack</div>
      <h2 class="font-serif text-3xl md:text-5xl font-semibold leading-[1.1] tracking-tight text-[var(--color-text)]">Your CSPM finds problems. InstaSecure retires categories of them.</h2>
      <p class="mt-6 text-lg text-slate-700 leading-relaxed">
        You don't have to rip and replace. Install a guardrail, watch the class of finding stop recurring. Alert fatigue stops — not because you muted the alerts, but because the conditions that create them no longer exist.
      </p>
    </div>
  </section>

  <div class="bg-slate-50">
    <VersusBlock
      eyebrow="The economics"
      title="Prevention scales. Detection doesn't."
      before={economicsBefore}
      after={economicsAfter}
    />
  </div>

  <TestimonialRow
    eyebrow="From the field"
    title="What security leaders are saying"
    testimonials={testimonials}
  />

  <section class="bg-[var(--color-text)] text-white">
    <div class="mx-auto max-w-5xl px-6 py-20 text-center">
      <div class="text-sm uppercase tracking-[0.15em] font-mono font-medium text-[var(--color-accent-on-dark)] mb-4">Self-serve on AWS</div>
      <h2 class="font-serif text-3xl md:text-5xl font-semibold leading-[1.1] tracking-tight text-white">Already on AWS? Start free in minutes.</h2>
      <p class="mt-6 text-lg text-white/70 leading-relaxed">AWS Partner · AWS Qualified Software. Procurement-friendly — bill through your existing AWS account, no new vendor onboarding.</p>
      <div class="mt-8">
        <Button href={AWS_MARKETPLACE} variant="accent" size="lg">Start free trial on AWS Marketplace →</Button>
        <p class="mt-4 text-sm font-mono uppercase tracking-[0.12em] text-white/60">No credit card · Bills via your AWS account · Cancel anytime</p>
      </div>
      <div class="mt-12 flex flex-wrap gap-10 md:gap-16 justify-center items-center">
        {trustBadgesResolved.map((b) => {
          const renderedHeight = 64;
          const aspect = b.intrinsicWidth && b.intrinsicHeight ? b.intrinsicWidth / b.intrinsicHeight : 1;
          const renderedWidth = Math.round(renderedHeight * aspect);
          const img = (
            <img
              src={b.src}
              alt={b.alt}
              width={renderedWidth}
              height={renderedHeight}
              loading="lazy"
              decoding="async"
              class="object-contain"
              style={`height: ${renderedHeight}px; width: ${renderedWidth}px;`}
            />
          );
          return b.href
            ? <a href={b.href} target="_blank" rel="noopener" class="hover:opacity-80 transition">{img}</a>
            : <div>{img}</div>;
        })}
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="mb-14">
        <SectionHeader
          eyebrow="Field notes"
          title="More on guardrails, agentic identity, and AWS perimeters"
        />
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {latestPosts.map(post => (
          <a href={post.href} class="group p-6 rounded-2xl border border-black/5 bg-white hover:shadow-lg hover:-translate-y-0.5 transition">
            <div class="text-sm font-mono uppercase tracking-[0.12em] text-slate-500">{post.date}</div>
            <h3 class="mt-3 text-lg font-bold text-[var(--color-text)] leading-snug tracking-tight group-hover:text-[var(--color-brand)] transition">{post.title}</h3>
            <div class="mt-5 text-sm font-semibold text-[var(--color-brand)]">Read post →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <SectionHeader
      eyebrow="Deep dives"
      title="The techniques behind preventive cloud security"
      subtitle="Field guides and use-case briefs on the AWS-native primitives that make whole classes of attack structurally impossible."
    />
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 mt-14">
      <a href="/data-perimeter-on-aws" class="group block p-6 rounded-2xl border border-black/5 bg-white hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="text-xs uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-3">Solution</div>
        <h3 class="text-lg font-bold text-[var(--color-text)] leading-snug tracking-tight group-hover:text-[var(--color-brand)] transition">AWS Data Perimeter — definition and 3 pillars</h3>
        <p class="mt-3 text-[15px] text-slate-700 leading-relaxed">Trusted identities, trusted resources, expected networks — the closed perimeter against stolen credentials.</p>
      </a>
      <a href="/credential-compromise" class="group block p-6 rounded-2xl border border-black/5 bg-white hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="text-xs uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-3">Use case</div>
        <h3 class="text-lg font-bold text-[var(--color-text)] leading-snug tracking-tight group-hover:text-[var(--color-brand)] transition">Credential compromise on AWS — and how to stop it</h3>
        <p class="mt-3 text-[15px] text-slate-700 leading-relaxed">Why valid stolen credentials defeat detection — and how preventive controls deny the action at the control plane.</p>
      </a>
      <a href="/learn/aws-organizational-policies" class="group block p-6 rounded-2xl border border-black/5 bg-white hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="text-xs uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-3">Interactive simulator</div>
        <h3 class="text-lg font-bold text-[var(--color-text)] leading-snug tracking-tight group-hover:text-[var(--color-brand)] transition">SCPs and RCPs — try the AWS organizational policy gates</h3>
        <p class="mt-3 text-[15px] text-slate-700 leading-relaxed">Click through six trust scenarios and watch which gate blocks each one — with a tabbed deep-dive on AWS evaluation logic.</p>
      </a>
      <a href="/cloud-zero-day-attack-solution" class="group block p-6 rounded-2xl border border-black/5 bg-white hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="text-xs uppercase tracking-[0.15em] font-bold text-[var(--color-brand)] mb-3">Use case</div>
        <h3 class="text-lg font-bold text-[var(--color-text)] leading-snug tracking-tight group-hover:text-[var(--color-brand)] transition">AI-driven zero-day attacks — preventive defense</h3>
        <p class="mt-3 text-[15px] text-slate-700 leading-relaxed">AI agents weaponize CVEs in hours. Preventive controls don't depend on knowing the vulnerability — they close the path.</p>
      </a>
    </div>
  </section>

  <CTAStripe
    title="Find your phase. Get your next 10 guardrails."
    description="Four minutes of questions, one report. Which guardrails your AWS org is missing, which classes of attack you're exposed to, and the fastest path to enforcement."
    supporting="No sales call to see the report. Book a threat model only if you want one."
    primaryCta={{ label: 'Run the assessment', href: '/contact' }}
    secondaryCta={{ label: 'Book a threat model', href: '/contact' }}
  />
</BaseLayout>
