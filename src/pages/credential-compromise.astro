---
import UseCaseLayout from '@/layouts/UseCaseLayout.astro';
import FeatureGrid from '@/components/sections/FeatureGrid.astro';
import Video from '@/components/ui/Video.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import IconBadge from '@/components/ui/IconBadge.astro';

const problemBullets = [
  'Rapid growth of credentials in your cloud environment — service roles, users, automation tokens, third-party integrations',
  'Corresponding growth of likelihood that credentials will be unintentionally leaked or stolen',
  'Leaked credentials are easy for attackers to use — globally, from anywhere, without needing to breach anything else',
  'Credentials often have unnecessarily broad access ("blast radius"), so one compromise reaches far',
];

const solutionPillars = [
  {
    icon: 'lucide:badge-check',
    iconColor: 'brand' as const,
    title: 'Trusted Cloud Identities',
    description: 'Only recognized, active, owned identities can make the call. Stolen or dormant credentials are blocked at the control plane — not at the audit log later.',
  },
  {
    icon: 'lucide:database',
    iconColor: 'accent' as const,
    title: 'Trusted Resources',
    description: 'Only approved AWS resources can be the target of privileged actions. S3 buckets outside the perimeter, unknown KMS keys, sideways account access — all denied.',
  },
  {
    icon: 'lucide:network',
    iconColor: 'brand' as const,
    title: 'Expected Networks',
    description: 'Privileged actions must originate from networks you trust — corporate VPCs, Identity Center endpoints, approved CI/CD runners. Rogue IPs are refused.',
  },
];
---
<UseCaseLayout
  title="Credential Compromise: Definition, Examples & Proactive AWS Defense | InstaSecure"
  description="What does credential compromise mean? Definition, examples of stolen AWS credentials, and how proactive credential security at the AWS control plane stops attackers — even with valid keys. InstaSecure's Data Perimeter blocks compromised credentials from rogue networks against unapproved resources."
  eyebrow="Solution · Credential Compromise"
  heroTitle="The Credential Compromise Problem"
  heroDescription="Attackers harvest compromised or leaked cloud credentials and use them from anywhere in the world to penetrate cloud environments — reaching business-critical or customer data in minutes. InstaSecure stops it at the control plane."
>
  <section class="mx-auto max-w-7xl px-6 py-16">
    <Video id="ujfjOpjG_zU" />
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-12">
    <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] tracking-tight">What is credential compromise?</h2>
    <p class="mt-5 text-lg text-slate-700 leading-relaxed">
      Credential compromise is when an attacker obtains valid cloud authentication material — IAM access keys, session tokens, OIDC credentials, or workforce SSO sessions — and uses them to impersonate a legitimate identity. Unlike a vulnerability exploit, the attacker doesn't break in. They walk in with the right keys.
    </p>
    <p class="mt-4 text-lg text-slate-700 leading-relaxed">
      In AWS, that means access logs look normal, the request signs cleanly, and downstream services trust the call. The only defense that survives this is a preventive control that denies the action at the control plane based on <em>where</em> the credential is being used and <em>what</em> it's targeting — not just whether the auth is valid.
    </p>
  </section>

  <div class="bg-slate-50">
    <section class="mx-auto max-w-4xl px-6 py-20">
      <SectionHeader eyebrow="The Problem" title="Why is credential compromise so insidious?" />
      <ul class="max-w-2xl mx-auto mt-10 space-y-3">
        {problemBullets.map(b => (
          <li class="flex gap-4 items-start p-5 bg-white rounded-xl border border-black/5">
            <IconBadge name="lucide:alert-triangle" color="accent" size="sm" />
            <span class="text-[16px] text-slate-800 leading-relaxed">{b}</span>
          </li>
        ))}
      </ul>
      <div class="mt-12 max-w-2xl mx-auto p-6 rounded-2xl bg-[var(--color-text)] text-white">
        <div class="text-sm uppercase tracking-[0.15em] font-semibold text-[var(--color-accent-on-dark)] mb-3">The AI shift</div>
        <p class="text-[16px] leading-relaxed">
          AI changes the credential math. LLM-driven enumeration scripts test stolen access keys against thousands of AWS APIs in minutes. Detection-based defense loses the race. Only proactive credential security — denying the action at the control plane regardless of valid auth — keeps pace with AI-speed adversaries.
        </p>
      </div>
    </section>
  </div>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <SectionHeader
      eyebrow="Why Current Solutions Fall Short"
      title="Least Privilege isn't enough"
      subtitle="Least Privilege reduces access to required functions — but still grants stolen credentials some access. It's a narrower blast radius, not a closed perimeter. Continuous manual effort to maintain, and the attacker still gets in with stolen keys."
    />
  </section>

  <FeatureGrid
    eyebrow="The Solution"
    title="Only Trusted Identities, Trusted Resources, Expected Networks"
    subtitle="InstaSecure's AWS Data Perimeter combines three orthogonal controls. A stolen credential used from the wrong network against the wrong resource gets denied — even with valid authentication."
    features={solutionPillars}
    columns={3}
  />
</UseCaseLayout>
